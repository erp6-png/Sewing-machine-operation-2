void setIpKey(const char* key, const String& v) {
  IPAddress a;
  if (!a.fromString(v)) { Serial.println("Not an IP address: " + v); return; }
  cfgPrefs.putString(key, v);
  Serial.printf("Saved %s = %s  (type 'reboot' to use it)\n", key, v.c_str());
}

void handleCommand(String line) {
  line.trim();
  if (!line.length()) return;
  String lo = line; lo.toLowerCase();

  if (lo == "i")              printStatus();
  else if (lo == "show")      printSettings();
  else if (lo == "register")  { if (linkOn && ipReady) sayHello(); else Serial.println("LAN not ready"); }
  else if (lo == "c")         { portENTER_CRITICAL(&pulseMux); pulseCount++; lastPulseMs = millis(); hadPulse = true; portEXIT_CRITICAL(&pulseMux); Serial.println("Simulated pulse"); }
  else if (lo == "s")         pushEvent(EV_HEARTBEAT, 0);
  else if (lo == "r")         doResetCount();
  else if (lo == "d")         { clearFilterStats(); Serial.println("Filter stats cleared"); }
  else if (lo == "u")         checkOTA(true);
  else if (lo == "n")         { scanStartIdx = modeIdx; nextMode("manual"); }
  else if (lo == "f")         { healthRequired = true; scanStartIdx = 0; applyMode(0); }
  else if (lo == "reboot")    { saveCount(true); Serial.println("Restarting..."); delay(200); ESP.restart(); }
  else if (lo == "factory")   {
    cfgPrefs.clear();
    Serial.println("All settings erased (ID, key, network). Pulse count kept. Restarting...");
    delay(300); ESP.restart();
  }
  else if (lo.startsWith("set ")) {
    String rest = line.substring(4); rest.trim();
    int sp = rest.indexOf(' ');
    String what = (sp > 0 ? rest.substring(0, sp) : rest); what.toLowerCase();
    String val  = (sp > 0 ? rest.substring(sp + 1) : String("")); val.trim();
    if (what == "id")        { cfgPrefs.putString("id", val); cfg.deviceId = val; Serial.println("Saved id " + val); }
    else if (what == "key")  { cfgPrefs.putString("key", val); cfg.deviceKey = val; authFails = 0; Serial.println("Saved key"); }
    else if (what == "ip" || what == "gw" || what == "mask" || what == "dns") setIpKey(what.c_str(), val);
    else if (what == "dhcp") { bool on = val == "on"; cfgPrefs.putBool("dhcp", on); Serial.printf("DHCP %s  (type 'reboot')\n", on ? "on" : "off"); }
    else if (what == "server") {
      int c = val.indexOf(':');
      String ip = c > 0 ? val.substring(0, c) : val;
      uint16_t port = c > 0 ? (uint16_t)val.substring(c + 1).toInt() : DEF_SERVER_PORT;
      IPAddress a;
      if (!a.fromString(ip) || port == 0) { Serial.println("Use: set server 10.5.20.2:5000"); return; }
      cfgPrefs.putString("srv", ip); cfgPrefs.putUShort("port", port);
      cfg.serverIp = a; cfg.serverPort = port;
      Serial.printf("Server %s:%u saved\n", ip.c_str(), port);
    }
    else if (what == "mac") {
      byte m[6];
      if (val == "auto") { cfgPrefs.remove("mac"); Serial.println("MAC = chip MAC  (type 'reboot')"); }
      else if (strToMac(val, m)) { cfgPrefs.putString("mac", val); Serial.println("MAC saved  (type 'reboot')"); }
      else Serial.println("Use: set mac AA:BB:CC:DD:EE:FF  or  set mac auto");
    }
    else if (what == "wifi") {
      if (val == "off") { cfgPrefs.remove("wssid"); cfgPrefs.remove("wpass"); Serial.println("WiFi off  (type 'reboot')"); }
      else {
        int s2 = val.indexOf(' ');
        String ssid = s2 > 0 ? val.substring(0, s2) : val;
        String pass = s2 > 0 ? val.substring(s2 + 1) : String("");
        cfgPrefs.putString("wssid", ssid); cfgPrefs.putString("wpass", pass);
        Serial.println("WiFi " + ssid + " saved  (type 'reboot')");
      }
    }
    else Serial.println("Unknown setting: " + what);
  }
  else Serial.println("Commands: i, show, register, c, s, r, d, u, n, f, set ..., reboot, factory");
}

void handleSerial() {
  while (Serial.available()) {
    char ch = (char)Serial.read();
    if (ch == '\n' || ch == '\r') { if (serialLine.length()) { handleCommand(serialLine); serialLine = ""; } }
    else if (serialLine.length() < 120) serialLine += ch;
  }
}

// =======================================================================
//                               SETUP / LOOP
// =======================================================================
void setupWatchdog() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_task_wdt_config_t wc = { WDT_TIMEOUT_S * 1000, 0, true };
  if (esp_task_wdt_init(&wc) != ESP_OK) esp_task_wdt_reconfigure(&wc);
#else
  esp_task_wdt_init(WDT_TIMEOUT_S, true);
#endif
  esp_task_wdt_add(NULL);
}

void setup() {
  Serial.begin(115200);
  delay(300);
  setupWatchdog();
  pinMode(STATUS_LED, OUTPUT);
  digitalWrite(STATUS_LED, LOW);

  uint8_t f[6];
  esp_read_mac(f, ESP_MAC_WIFI_STA);                 // factory MAC = permanent HW ID
  hwId = macToStr(f);

  loadConfig();
  setupMac();

  prefs.begin("machine", false);
  seqNo           = prefs.getUInt("seq", 0);
  pulseCount      = prefs.getUInt("pulses", 0);
  lastCmdId       = prefs.getUInt("cmd", 0);
  modeIdx         = prefs.getUChar("phymode", 0);
  if (modeIdx < 0 || modeIdx >= NUM_MODES) modeIdx = 0;
  scanStartIdx    = modeIdx;
  lastSavedPulses = lastSeenPulses = pulseCount;
  lastBlock       = pulseCount / cfg.sendEvery;

  Serial.println();
  Serial.println("==============================================");
  Serial.println(" MACHINE MONITOR  universal firmware " FW_VERSION);
  Serial.println(" HW ID   : " + hwId);
  Serial.println(" LAN MAC : " + macToStr(mac));
  Serial.println(" Name    : " + deviceName());
  Serial.println(" Status  : " + (registered() ? String("registered as ") + cfg.deviceId : String("NOT registered - will ask the server")));
  Serial.printf (" Server  : %s:%u   pulses %u\n", cfg.serverIp.toString().c_str(), cfg.serverPort, (uint32_t)pulseCount);
  Serial.println("==============================================");

  // W5500: hardware reset, SPI
  pinMode(PIN_CS, OUTPUT);
  digitalWrite(PIN_CS, HIGH);
  pinMode(PIN_RST, OUTPUT);
  digitalWrite(PIN_RST, LOW);
  delay(50);
  digitalWrite(PIN_RST, HIGH);
  delay(300);
  SPI.begin(PIN_SCK, PIN_MISO, PIN_MOSI, PIN_CS);
  Ethernet.init(PIN_CS);

  chipPresent = chipOK();
  if (chipPresent) applyMode(modeIdx);
  else Serial.println("[LAN] W5500 not found - check wiring");

  startSensor();
  idleSince = millis();
  lastHeartbeat = millis();
  pushEvent(EV_BOOT, 0);
  Serial.println("Type 'i' for status, 'show' for settings.");
}

void loop() {
  feedWdt();
  uint32_t now = millis();
  handleSerial();
  handleLan(now);
  handleCounting(now);
  handleTimers(now);
  handleRegistration(now);
  fetchConfig(now);
  processQueue();
  handleOTA(now);
  handleWifi(now);
  delay(1);
}8
