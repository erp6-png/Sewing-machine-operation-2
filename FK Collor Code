void loadConfig() {
  cfgPrefs.begin("cfg", false);

#if MIGRATE_FROM_V1
  if (!cfgPrefs.isKey("key")) {                      // first boot after OTA from v1.2.x
    cfgPrefs.putString("id", MIG_ID);
    cfgPrefs.putString("key", MIG_KEY);
    cfgPrefs.putBool("dhcp", false);
    cfgPrefs.putString("ip", MIG_IP);
    cfgPrefs.putString("gw", MIG_GW);
    cfgPrefs.putString("mask", MIG_MASK);
    cfgPrefs.putString("dns", MIG_DNS);
    cfgPrefs.putString("mac", MIG_MAC);
    Serial.println("[CFG] Migrated v1 settings into flash");
  }
#endif

  if (!cfgPrefs.isKey("ip")) {                       // very first start: save the network from the code
    cfgPrefs.putBool("dhcp", DEF_USE_DHCP);
    cfgPrefs.putString("ip", DEF_STATIC_IP);
    cfgPrefs.putString("gw", DEF_GATEWAY);
    cfgPrefs.putString("mask", DEF_SUBNET_MASK);
    cfgPrefs.putString("dns", DEF_DNS_SERVER);
    Serial.println("[CFG] First start: network " DEF_STATIC_IP " saved in flash");
  }

  cfg.deviceId      = cfgPrefs.getString("id", "");
  cfg.deviceKey     = cfgPrefs.getString("key", "");
  cfg.dhcp          = cfgPrefs.getBool("dhcp", DEF_USE_DHCP);
  cfg.ip            = strToIp(cfgPrefs.getString("ip", ""),   IPAddress(0, 0, 0, 0));
  cfg.gw            = strToIp(cfgPrefs.getString("gw", ""),   IPAddress(0, 0, 0, 0));
  cfg.mask          = strToIp(cfgPrefs.getString("mask", ""), IPAddress(255, 255, 255, 0));
  cfg.dns           = strToIp(cfgPrefs.getString("dns", ""),  cfg.gw);
  cfg.serverIp      = strToIp(cfgPrefs.getString("srv", DEF_SERVER_IP), strToIp(DEF_SERVER_IP, IPAddress(0, 0, 0, 0)));
  cfg.serverPort    = cfgPrefs.getUShort("port", DEF_SERVER_PORT);
  cfg.macStr        = cfgPrefs.getString("mac", "");
  cfg.idleTimeoutMs = cfgPrefs.getUInt("idle", DEF_IDLE_TIMEOUT_MS);
  cfg.sendEvery     = cfgPrefs.getUInt("every", DEF_SEND_EVERY);
  cfg.stableLowMs   = cfgPrefs.getUInt("flow", DEF_STABLE_LOW_MS);
  cfg.releaseHighMs = cfgPrefs.getUInt("fhigh", DEF_RELEASE_HIGH_MS);
  cfg.minIntervalMs = cfgPrefs.getUInt("fmin", DEF_MIN_INTERVAL_MS);
  cfg.heartbeatMin  = cfgPrefs.getUInt("hb", DEF_HEARTBEAT_MIN);
  cfg.otaCheckSec   = cfgPrefs.getUInt("ota", DEF_OTA_CHECK_SEC);
  cfg.sendTimes     = cfgPrefs.getString("times", DEF_SEND_TIMES);
  cfg.wifiSsid      = cfgPrefs.getString("wssid", "");
  cfg.wifiPass      = cfgPrefs.getString("wpass", "");
  cfg.cfgVer        = cfgPrefs.getUInt("cver", 0);

  // keep values in a safe range even if flash holds something odd
  cfg.idleTimeoutMs = clampU(cfg.idleTimeoutMs, 2000, 600000);
  cfg.sendEvery     = clampU(cfg.sendEvery, 1, 1000);
  cfg.stableLowMs   = clampU(cfg.stableLowMs, 1, 50);
  cfg.releaseHighMs = clampU(cfg.releaseHighMs, 5, 1000);
  cfg.minIntervalMs = clampU(cfg.minIntervalMs, 20, 10000);
  cfg.heartbeatMin  = clampU(cfg.heartbeatMin, 0, 60);
  if (cfg.otaCheckSec != 0) cfg.otaCheckSec = clampU(cfg.otaCheckSec, 30, 86400);
  if (cfg.serverPort == 0) cfg.serverPort = DEF_SERVER_PORT;

  gStableLow   = cfg.stableLowMs;
  gReleaseHigh = cfg.releaseHighMs;
  gMinInterval = cfg.minIntervalMs;
}

// Apply settings sent by the server (hello / config / event reply). Network is NOT changed here.
void applyServerConfig(const String& js) {
  String s;
  uint32_t n;
  bool changed = false;

  if (jsonGet(js, "device_id", s) && s.length() && s != cfg.deviceId) { cfg.deviceId = s; cfgPrefs.putString("id", s); changed = true; }
  if (jsonGet(js, "device_key", s) && s.length() >= 8 && s != cfg.deviceKey) {
    cfg.deviceKey = s; cfgPrefs.putString("key", s); authFails = 0; changed = true;
    Serial.println("[REG] Device key received and saved");
  }
  if (jsonNum(js, "idle_timeout_ms", n))   { cfg.idleTimeoutMs = clampU(n, 2000, 600000); cfgPrefs.putUInt("idle", cfg.idleTimeoutMs); changed = true; }
  if (jsonNum(js, "send_every_pulses", n)) { cfg.sendEvery     = clampU(n, 1, 1000);       cfgPrefs.putUInt("every", cfg.sendEvery); lastBlock = pulseCount / cfg.sendEvery; changed = true; }
  if (jsonNum(js, "stable_low_ms", n))     { cfg.stableLowMs   = clampU(n, 1, 50);         cfgPrefs.putUInt("flow", cfg.stableLowMs); changed = true; }
  if (jsonNum(js, "release_high_ms", n))   { cfg.releaseHighMs = clampU(n, 5, 1000);       cfgPrefs.putUInt("fhigh", cfg.releaseHighMs); changed = true; }
  if (jsonNum(js, "min_interval_ms", n))   { cfg.minIntervalMs = clampU(n, 20, 10000);     cfgPrefs.putUInt("fmin", cfg.minIntervalMs); changed = true; }
  if (jsonNum(js, "heartbeat_min", n))     { cfg.heartbeatMin  = clampU(n, 0, 60);         cfgPrefs.putUInt("hb", cfg.heartbeatMin); changed = true; }
  if (jsonNum(js, "ota_check_sec", n))     { cfg.otaCheckSec   = (n == 0) ? 0 : clampU(n, 30, 86400); cfgPrefs.putUInt("ota", cfg.otaCheckSec); changed = true; }
  if (jsonGet(js, "send_times", s))        { cfg.sendTimes = s; cfgPrefs.putString("times", s); changed = true; }
  if (jsonNum(js, "cfg_ver", n) && n != cfg.cfgVer) { cfg.cfgVer = n; cfgPrefs.putUInt("cver", n); changed = true; }

  portENTER_CRITICAL(&pulseMux);
  gStableLow   = cfg.stableLowMs;
  gReleaseHigh = cfg.releaseHighMs;
  gMinInterval = cfg.minIntervalMs;
  portEXIT_CRITICAL(&pulseMux);

  if (changed) Serial.printf("[CFG] Settings from server applied (cfg_ver %u)\n", cfg.cfgVer);
}

void setupMac() {
  if (cfg.macStr.length() && strToMac(cfg.macStr, mac)) return;
  esp_read_mac(mac, ESP_MAC_ETH);                    // unique per chip
}

// =======================================================================
//                               SENSOR
// =======================================================================
void sensorTick(void*) {
  bool low = (digitalRead(SENSOR_PIN) == LOW);
  uint32_t now = millis();
  portENTER_CRITICAL(&pulseMux);
  if (fArmed) {
    if (low) {
      if (++fLowRun >= gStableLow) {
        if (!hadPulse || now - lastActivityMs >= gMinInterval) {
          if (hadPulse) {
            uint32_t iv = now - lastPulseMs;
            lastIntervalMs = iv;
            if (minIntervalMs == 0 || iv < minIntervalMs) minIntervalMs = iv;
          }
          pulseCount++;
          lastPulseMs = now;
          hadPulse = true;
          fCounted = true;
        } else {
          glitchFast++;
          fCounted = false;
        }
        lastActivityMs = now;
        fArmed = false;
        fWidthRun = fLowRun;
        fHighRun = 0;
      }
    } else {
      if (fLowRun > 0) glitchShort++;
      fLowRun = 0;
    }
  } else {
    if (low) {
      fHighRun = 0;
      if (fWidthRun < 60000) fWidthRun++;
    } else if (++fHighRun >= gReleaseHigh) {
      if (fCounted) {
        lastWidthMs = fWidthRun;
        if (minWidthMs == 0 || fWidthRun < minWidthMs) minWidthMs = fWidthRun;
      }
      fArmed = true;
      fLowRun = 0;
    }
  }
  portEXIT_CRITICAL(&pulseMux);
}

void startSensor() {
  pinMode(SENSOR_PIN, INPUT_PULLUP);
  esp_timer_create_args_t ta = {};
  ta.callback = &sensorTick;
  ta.name     = "sensor";
  if (esp_timer_create(&ta, &sensorTimer) == ESP_OK &&
      esp_timer_start_periodic(sensorTimer, 1000) == ESP_OK) {
    Serial.printf("[SENSOR] Filter ON: low %u ms, release %u ms, min interval %u ms\n",
                  (uint32_t)gStableLow, (uint32_t)gReleaseHigh, (uint32_t)gMinInterval);
  } else {
    Serial.println("[SENSOR] ERROR: timer start failed - pulses NOT counted");
  }
}

void clearFilterStats() {
  portENTER_CRITICAL(&pulseMux);
  glitchShort = glitchFast = 0;
  lastIntervalMs = minIntervalMs = 0;
  lastWidthMs = minWidthMs = 0;
  portEXIT_CRITICAL(&pulseMux);
}

// =======================================================================
//                               W5500 RAW
// =======================================================================
uint8_t regRead(uint16_t a) {
  SPI.beginTransaction(w5500SPI);
  digitalWrite(PIN_CS, LOW);
  SPI.transfer(a >> 8); SPI.transfer(a & 0xFF); SPI.transfer(0x00);
  uint8_t v = SPI.transfer(0x00);
  digitalWrite(PIN_CS, HIGH);
  SPI.endTransaction();
  return v;
}
void regWrite(uint16_t a, uint8_t v) {
  SPI.beginTransaction(w5500SPI);
  digitalWrite(PIN_CS, LOW);
  SPI.transfer(a >> 8); SPI.transfer(a & 0xFF); SPI.transfer(0x04); SPI.transfer(v);
  digitalWrite(PIN_CS, HIGH);
  SPI.endTransaction();
}
bool chipOK()  { return regRead(REG_VERSIONR) == 0x04; }
bool phyLink() { return regRead(REG_PHYCFGR) & 0x01; }

// =======================================================================
//                               TIME
// =======================================================================
uint32_t nowEpoch() { return epochAtSync + (millis() - millisAtSync) / 1000; }

String fmtTime(uint32_t epochUTC) {
  time_t t = (time_t)epochUTC + TZ_OFFSET_SEC;
  struct tm tmv;
  gmtime_r(&t, &tmv);
  char b[24];
  strftime(b, sizeof(b), "%Y-%m-%d %H:%M:%S", &tmv);
  return String(b);
}

void syncTimeFrom(const String& js) {
  uint32_t ep;
  if (jsonNum(js, "server_epoch", ep) && ep > 1600000000UL) {
    bool first = !timeValid;
    epochAtSync = ep; millisAtSync = millis(); timeValid = true;
    if (first) Serial.println("[TIME] Synced from server: " + fmtTime(ep));
  }
}

