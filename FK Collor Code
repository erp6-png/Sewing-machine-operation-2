String macToStr(const byte* m) {
  char b[18];
  snprintf(b, sizeof(b), "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
  return String(b);
}

bool strToMac(const String& s, byte* out) {
  int v[6];
  if (sscanf(s.c_str(), "%x:%x:%x:%x:%x:%x", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5]) != 6) return false;
  for (int i = 0; i < 6; i++) { if (v[i] < 0 || v[i] > 255) return false; out[i] = (byte)v[i]; }
  return true;
}

IPAddress strToIp(const String& s, IPAddress def) {
  IPAddress a;
  return a.fromString(s) ? a : def;
}

uint32_t clampU(uint32_t v, uint32_t lo, uint32_t hi) { return v < lo ? lo : (v > hi ? hi : v); }

String deviceName() {                                // also used as WiFi hostname (no ':' allowed)
  if (cfg.deviceId.length()) return cfg.deviceId;
  String h = hwId.substring(9);
  h.replace(":", "");
  return "MM-" + h;
}

// Tiny reader for FLAT json objects: {"a":"x","b":12,"c":true}
// Returns false if the key is missing or null.
bool jsonGet(const String& js, const char* key, String& out) {
  String pat = String("\"") + key + "\"";
  int len = js.length();
  int k = js.indexOf(pat);
  while (k >= 0) {
    int p = k + pat.length();
    while (p < len && js[p] == ' ') p++;
    if (p < len && js[p] == ':') {
      p++;
      while (p < len && js[p] == ' ') p++;
      if (p < len && js[p] == '"') {
        String s;
        p++;
        while (p < len && js[p] != '"') {
          if (js[p] == '\\' && p + 1 < len) p++;
          s += js[p];
          p++;
        }
        out = s;
        return true;
      }
      int e = p;
      while (e < len && js[e] != ',' && js[e] != '}' && js[e] != ' ' && js[e] != '\r' && js[e] != '\n') e++;
      out = js.substring(p, e);
      out.trim();
      return out.length() > 0 && out != "null";
    }
    k = js.indexOf(pat, k + 1);
  }
  return false;
}

bool jsonNum(const String& js, const char* key, uint32_t& out) {
  String s;
  if (!jsonGet(js, key, s)) return false;
  for (size_t i = 0; i < s.length(); i++) if (!isDigit(s[i])) return false;
  out = strtoul(s.c_str(), nullptr, 10);
  return true;
}

