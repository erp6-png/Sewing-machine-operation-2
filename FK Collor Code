void noteServerResult(bool ok) {
  lastServerOK = ok;
  if (ok) healthFails = 0; else healthFails++;
}

static String readLine(EthernetClient& c, uint32_t timeoutMs) {
  String s;
  uint32_t t = millis();
  while (millis() - t < timeoutMs) {
    while (c.available()) {
      char ch = (char)c.read();
      if (ch == '\n') return s;
      if (ch != '\r' && s.length() < 200) s += ch;
      t = millis();
    }
    if (!c.connected()) break;
    delay(1);
  }
  return s;
}

// Simple HTTP/1.1 request. Returns status code (0 = no connection / no reply).
int httpRequest(const char* method, const String& path, const String& body, String& respBody) {
  respBody = "";
  EthernetClient c;
  c.setConnectionTimeout(2000);
  if (!c.connect(cfg.serverIp, cfg.serverPort)) { noteServerResult(false); return 0; }

  c.print(String(method) + " " + path + " HTTP/1.1\r\n");
  c.print("Host: " + cfg.serverIp.toString() + "\r\n");
  if (body.length()) {
    c.print("Content-Type: application/json\r\n");
    c.print("Content-Length: " + String(body.length()) + "\r\n");
  }
  c.print("Connection: close\r\n\r\n");
  if (body.length()) c.print(body);

  String status = readLine(c, 4000);
  int sp = status.indexOf(' ');
  int code = (sp > 0) ? status.substring(sp + 1, sp + 4).toInt() : 0;

  int len = -1;
  while (true) {
    String h = readLine(c, 3000);
    if (h.length() == 0) break;
    String lo = h; lo.toLowerCase();
    if (lo.startsWith("content-length:")) len = h.substring(15).toInt();
  }
  uint32_t t = millis();
  while (millis() - t < 3000 && respBody.length() < 2048 && (len < 0 || (int)respBody.length() < len)) {
    while (c.available() && respBody.length() < 2048) { respBody += (char)c.read(); t = millis(); }
    if (!c.connected() && !c.available()) break;
    delay(1);
  }
  c.stop();
  noteServerResult(code > 0);           // any HTTP reply = server reachable
  return code;
}

// ---------- Commands sent by the server (each runs once) ----------
void pushEvent(EvType type, uint32_t dur);
void checkOTA(bool manual);
void nextMode(const char* reason);
void saveCount(bool force);

void doResetCount() {
  portENTER_CRITICAL(&pulseMux);
  pulseCount = 0;
  portEXIT_CRITICAL(&pulseMux);
  lastSeenPulses = 0; lastBlock = 0;
  saveCount(true);
  pushEvent(EV_RESET, 0);
}

void handleServerCommand(const String& js) {
  uint32_t id;
  String name;
  if (!jsonNum(js, "cmd_id", id) || !jsonGet(js, "cmd", name)) return;
  if (id <= lastCmdId) return;                       // already done
  lastCmdId = id;
  prefs.putUInt("cmd", id);                          // save BEFORE running (reboot-safe)
  Serial.printf("[CMD] Server command #%u: %s\n", id, name.c_str());
  if      (name == "reset_count") doResetCount();
  else if (name == "clear_stats") clearFilterStats();
  else if (name == "ota_check")   lastOtaCheck = 0, otaLast = "check requested";
  else if (name == "lan_rescan")  { scanStartIdx = modeIdx; nextMode("server command"); }
  else if (name == "reboot")      { saveCount(true); delay(200); ESP.restart(); }
  else Serial.println("[CMD] Unknown command - ignored");
}

// Common handling of every server reply
void handleReply(const String& js) {
  syncTimeFrom(js);
  uint32_t v;
  if (jsonNum(js, "cfg_ver", v) && v != cfg.cfgVer) configWanted = true;
  handleServerCommand(js);
}

// ---------- Registration ----------
void sayHello() {
  String j = "{";
  j += "\"hw_id\":\"" + hwId + "\",";
  j += "\"mac\":\"" + macToStr(mac) + "\",";
  j += "\"device_id\":\"" + cfg.deviceId + "\",";
  j += "\"has_key\":" + String(registered() ? "true" : "false") + ",";
  j += "\"fw\":\"" FW_VERSION "\",";
  j += "\"ip\":\"" + Ethernet.localIP().toString() + "\",";
  j += "\"pulses\":" + String((uint32_t)pulseCount);
  j += "}";

  String resp;
  int code = httpRequest("POST", HELLO_PATH, j, resp);
  if (code == 0) { regStatus = "server not reachable"; return; }
  syncTimeFrom(resp);

  String st;
  jsonGet(resp, "status", st);
  if (code == 200 && st == "approved") {
    applyServerConfig(resp);
    handleServerCommand(resp);
    regStatus = "approved as " + cfg.deviceId;
    Serial.println("[REG] " + regStatus);
    sendDelay = 0;
  } else if (code == 202 || st == "pending") {
    regStatus = "pending - approve HW ID " + hwId + " in Device Manager";
    Serial.println("[REG] " + regStatus);
  } else if (code == 403 || st == "disabled") {
    regStatus = "disabled in Device Manager";
    Serial.println("[REG] Device is disabled in the app");
  } else {
    regStatus = "hello failed (HTTP " + String(code) + ")";
    Serial.println("[REG] " + regStatus);
  }
}

void handleRegistration(uint32_t now) {
  if (!linkOn || !ipReady) return;
  // Unregistered: ask every 30 s.  Key rejected 3x: ask every 60 s (recovery, key kept until a new one arrives)
  uint32_t every = !registered() ? 30000UL : (authFails >= 3 ? 60000UL : 0);
  if (every == 0) return;
  if (lastHello != 0 && now - lastHello < every) return;
  lastHello = now;
  sayHello();
}

void fetchConfig(uint32_t now) {
  if (!configWanted || !registered() || !linkOn || !ipReady) return;
  if (lastConfigTry != 0 && now - lastConfigTry < 30000) return;
  lastConfigTry = now;
  String resp;
  int code = httpRequest("GET", String(CONFIG_PATH) + "?key=" + cfg.deviceKey + "&hw_id=" + hwId, "", resp);
  if (code == 200) {
    applyServerConfig(resp);
    handleServerCommand(resp);
    configWanted = false;
  } else {
    Serial.printf("[CFG] Config download failed (HTTP %d)\n", code);
  }
}

// =======================================================================
//                               EVENTS
// =======================================================================
void pushEvent(EvType type, uint32_t dur) {
  Event e;
  e.type    = type;
  e.running = running ? 1 : 0;
  e.pulses  = pulseCount;
  e.ms      = millis();
  e.seq     = ++seqNo;
  e.dur     = dur;
  prefs.putUInt("seq", seqNo);

  if (qCount == QSIZE) {
    qHead = (qHead + 1) % QSIZE;
    qCount--;
    qDropped++;
  }
  q[(qHead + qCount) % QSIZE] = e;
  qCount++;

  Serial.printf("[EVENT] #%u %s  pulses=%u  dur=%us  (queue %d)\n",
                e.seq, EV_NAMES[type], e.pulses, dur, qCount);
}

void saveCount(bool force) {
  uint32_t c = pulseCount;
  if (c == lastSavedPulses) return;
  if (!force && millis() - lastSaveMs < 10000) return;
  prefs.putUInt("pulses", c);
  lastSavedPulses = c;
  lastSaveMs = millis();
}

bool sendEvent(const Event& e) {
  uint32_t age = (millis() - e.ms) / 1000;
  String j = "{";
  j += "\"device_id\":\"" + cfg.deviceId + "\",";
  j += "\"hw_id\":\"" + hwId + "\",";
  j += "\"seq\":" + String(e.seq) + ",";
  j += "\"event\":\"" + String(EV_NAMES[e.type]) + "\",";
  j += "\"state\":\"" + String(e.running ? "RUNNING" : "IDLE") + "\",";
  j += "\"pulses\":" + String(e.pulses) + ",";
  j += "\"duration_s\":" + String(e.dur) + ",";
  j += "\"age_s\":" + String(age) + ",";
  j += "\"device_time\":\"" + (timeValid ? fmtTime(nowEpoch() - age) : String("NA")) + "\",";
  j += "\"uptime_s\":" + String(millis() / 1000) + ",";
  j += "\"queued\":" + String(qCount - 1) + ",";
  j += "\"fw\":\"" FW_VERSION "\",";
  j += "\"cfg_ver\":" + String(cfg.cfgVer) + ",";
  j += "\"cmd_ack\":" + String(lastCmdId) + ",";
  j += "\"flt_short\":" + String((uint32_t)glitchShort) + ",";
  j += "\"flt_fast\":" + String((uint32_t)glitchFast) + ",";
  j += "\"min_interval_ms\":" + String((uint32_t)minIntervalMs) + ",";
  j += "\"min_width_ms\":" + String((uint32_t)minWidthMs) + ",";
  j += "\"ip\":\"" + Ethernet.localIP().toString() + "\"";
  j += "}";

  String resp;
  int code = httpRequest("POST", String(EVENT_PATH) + "?key=" + cfg.deviceKey, j, resp);
  bool ok = code >= 200 && code < 300;

  if (ok) {
    authFails = 0;
    handleReply(resp);
    sentOK++;
    Serial.printf("[SEND] OK  #%u %s\n", e.seq, EV_NAMES[e.type]);
  } else {
    sentFail++;
    if (code == 401) authFails++;
    Serial.printf("[SEND] FAILED #%u (HTTP %d)%s\n", e.seq, code,
                  code == 401 ? "  -> key not accepted, asking server again" :
                  code == 409 ? "  -> device not linked to a machine in Device Manager" : "");
  }
  return ok;
}

void processQueue() {
  if (qCount == 0 || !linkOn || !ipReady || !registered()) return;
  if (millis() - lastSendTry < sendDelay) return;
  lastSendTry = millis();
  if (sendEvent(q[qHead])) {
    qHead = (qHead + 1) % QSIZE;
    qCount--;
    sendDelay = 100;
  } else {
    sendDelay = 10000;
  }
}

// =======================================================================
//                               OTA OVER LAN (pull from server)
// =======================================================================
void checkOTA(bool manual) {
  if (!linkOn || !ipReady) { if (manual) Serial.println("[OTA] LAN not ready"); return; }
  if (!registered())       { if (manual) Serial.println("[OTA] Not registered yet"); return; }
  if (qCount > 0 && !manual) return;

  EthernetClient c;
  c.setConnectionTimeout(3000);
  if (!c.connect(cfg.serverIp, cfg.serverPort)) { otaLast = "server not reachable"; noteServerResult(false); return; }

  c.print(String("GET ") + OTA_PATH + "?key=" + cfg.deviceKey + "&device_id=" + cfg.deviceId +
          "&hw_id=" + hwId + "&version=" FW_VERSION " HTTP/1.1\r\n");
  c.print("Host: " + cfg.serverIp.toString() + "\r\n");
  c.print("Connection: close\r\n\r\n");

  String status = readLine(c, 5000);
  int sp = status.indexOf(' ');
  int code = (sp > 0) ? status.substring(sp + 1, sp + 4).toInt() : 0;
  noteServerResult(code > 0);

  int len = -1;
  String md5, ver;
  while (true) {
    String h = readLine(c, 5000);
    if (h.length() == 0) break;
    String lo = h; lo.toLowerCase();
    if (lo.startsWith("content-length:")) len = h.substring(15).toInt();
    else if (lo.startsWith("x-md5:"))     { md5 = h.substring(6); md5.trim(); }
    else if (lo.startsWith("x-version:")) { ver = h.substring(10); ver.trim(); }
  }

  if (code == 304) { c.stop(); otaLast = "up to date (" FW_VERSION ")"; if (manual) Serial.println("[OTA] Up to date"); return; }
  if (code != 200 || len <= 0) { c.stop(); otaLast = "HTTP " + String(code); Serial.printf("[OTA] Check failed (HTTP %d)\n", code); return; }

  Serial.printf("[OTA] New firmware %s (%d bytes) -> updating...\n", ver.c_str(), len);
  saveCount(true);
  if (!Update.begin(len)) { Serial.println("[OTA] Not enough space - check Partition Scheme"); c.stop(); otaLast = "no space"; return; }
  if (md5.length() == 32) Update.setMD5(md5.c_str());

  uint8_t buf[1024];
  int done = 0, lastPct = -1;
  uint32_t t = millis();
  while (done < len && millis() - t < 15000) {
    feedWdt();
    int n = c.available();
    if (n > 0) {
      n = c.read(buf, min(n, (int)sizeof(buf)));
      if (n > 0) {
        if (Update.write(buf, n) != (size_t)n) break;
        done += n;
        t = millis();
        int pct = (int)((done * 100LL) / len);
        if (pct / 10 != lastPct / 10) { Serial.printf("[OTA] %d%%\n", pct); lastPct = pct; }
      }
    } else if (!c.connected()) {
      break;
    } else {
      delay(1);
    }
  }
  c.stop();

  if (done == len && Update.end(true)) {
    Serial.printf("[OTA] Done -> version %s. Restarting...\n", ver.c_str());
    saveCount(true);
    delay(300);
    ESP.restart();
  } else {
    Update.abort();
    otaLast = "failed at " + String(done) + "/" + String(len);
    Serial.printf("[OTA] FAILED (%d/%d bytes, %s) - old firmware kept\n", done, len, Update.errorString());
  }
}

void handleOTA(uint32_t now) {
  if (cfg.otaCheckSec == 0 && lastOtaCheck != 0) return;
  if (lastOtaCheck != 0 && now - lastOtaCheck < cfg.otaCheckSec * 1000UL) return;
  if (!registered() || !linkOn || !ipReady) return;
  lastOtaCheck = now;
  checkOTA(false);
}

// =======================================================================
//                               WIFI (optional, laptop OTA)
// =======================================================================
void handleWifi(uint32_t now) {
  if (cfg.wifiSsid.length() == 0) return;
  if (!wifiStarted) {
    WiFi.mode(WIFI_STA);
    WiFi.setHostname(deviceName().c_str());
    WiFi.setAutoReconnect(true);
    WiFi.begin(cfg.wifiSsid.c_str(), cfg.wifiPass.c_str());
    wifiStarted = true;
    lastWifiTry = now;
    return;
  }
  if (WiFi.status() == WL_CONNECTED) {
    if (!wifiOtaReady) {
      ArduinoOTA.setHostname(deviceName().c_str());
      ArduinoOTA.setPassword(OTA_PASSWORD);
      ArduinoOTA.onStart([]() { saveCount(true); Serial.println("[WIFI-OTA] Upload started"); });
      ArduinoOTA.onEnd([]()   { saveCount(true); Serial.println("[WIFI-OTA] Done, restarting"); });
      ArduinoOTA.onError([](ota_error_t e) { Serial.printf("[WIFI-OTA] Error %u\n", e); });
      ArduinoOTA.begin();
      wifiOtaReady = true;
      Serial.print("[WIFI] Connected  IP "); Serial.println(WiFi.localIP());
    }
    ArduinoOTA.handle();
  } else if (now - lastWifiTry > 60000) {
    lastWifiTry = now;
    WiFi.disconnect();
    WiFi.begin(cfg.wifiSsid.c_str(), cfg.wifiPass.c_str());
  }
}

// =======================================================================
//                               LAN AUTO MODE
// =======================================================================
void writePhy(uint8_t bits) {
  regWrite(REG_PHYCFGR, bits);
  delay(100);
  regWrite(REG_PHYCFGR, bits | 0x80);
}

void applyMode(int idx) {
  modeIdx = idx;
  Serial.printf("[LAN] Trying %s\n", MODES[modeIdx].name);
  writePhy(MODES[modeIdx].bits);
  uint32_t now = millis();
  modeStart = linkChangeMs = now;
  linkOn = ipReady = ignoreDrop = confirmed = lastServerOK = false;
  dropsInMode = healthFails = 0;
}

void nextMode(const char* reason) {
  Serial.printf("[LAN] %s failed: %s\n", MODES[modeIdx].name, reason);
  int n = (modeIdx + 1) % NUM_MODES;
  if (n == scanStartIdx && healthRequired) {
    healthRequired = false;
    Serial.println("[LAN] Server unreachable in ALL modes -> IP/server problem, not speed.");
    Serial.println("      Check 'show' settings, server program, firewall port.");
  }
  applyMode(n);
}

void ensurePhyMode() {
  if ((regRead(REG_PHYCFGR) & 0x78) != MODES[modeIdx].bits) {
    ignoreDrop = true;
    writePhy(MODES[modeIdx].bits);
  }
}

void setupIP() {
  Ethernet.init(PIN_CS);
  usingDHCP = false;
  if (cfg.dhcp) {
    Serial.println("[NET] DHCP...");
    feedWdt();
    usingDHCP = Ethernet.begin(mac, 6000, 3000);
    feedWdt();
  }
  if (!usingDHCP) {
    if (cfg.ip == IPAddress(0, 0, 0, 0)) {
      Serial.println("[NET] No DHCP answer and no static IP set.");
      Serial.println("      Type over USB:  set ip <a.b.c.d> / set gw / set mask / set dns / set dhcp off / reboot");
      ipReady = false;
      return;
    }
    Ethernet.begin(mac, cfg.ip, cfg.dns, cfg.gw, cfg.mask);
    Serial.println("[NET] Static IP " + Ethernet.localIP().toString());
  } else {
    Serial.println("[NET] DHCP IP " + Ethernet.localIP().toString());
  }
  ipReady = true;
}

// quick TCP test while a LAN mode is not confirmed yet and nothing else talked to the server
void healthTest() {
  EthernetClient c;
  c.setConnectionTimeout(2000);
  bool ok = c.connect(cfg.serverIp, cfg.serverPort);
  c.stop();
  noteServerResult(ok);
  if (!ok) Serial.printf("[LAN] Server %s:%u not reachable (%u)\n", cfg.serverIp.toString().c_str(), cfg.serverPort, healthFails);
}

void handleLan(uint32_t now) {
  // W5500 present?
  if (!chipPresent) {
    if (now - lastChipCheck < 5000) return;
    lastChipCheck = now;
    chipPresent = chipOK();
    if (!chipPresent) { Serial.println("[LAN] W5500 not found - check wiring (MISO 19, MOSI 23, SCK 18, CS 5, RST 4, 5V, GND)"); return; }
    Serial.println("[LAN] W5500 found");
    applyMode(modeIdx);
  }

  if (now - lastPoll < 200) return;
  lastPoll = now;

  bool l = phyLink();
  if (l != linkOn) {
    linkChangeMs = now;
    if (l) {
      linkOn = true;
      Serial.printf("[LAN] Link UP (%s)\n", MODES[modeIdx].name);
      if (!ipReady) setupIP();
      ensurePhyMode();                               // Ethernet.begin resets the chip -> set our mode again
      lastHealthTest = now;
    } else {
      linkOn = false;
      if (ignoreDrop) {
        ignoreDrop = false;                          // our own PHY reset, not a real drop
      } else {
        dropTotal++;
        dropsInMode++;
        Serial.printf("[LAN] Link DOWN (drop %u in this mode)\n", dropsInMode);
        if (!confirmed && dropsInMode >= DROP_LIMIT) { nextMode("link keeps dropping"); return; }
      }
    }
  }

  if (!linkOn) {
    if (!confirmed && now - modeStart > LINK_WAIT_MS && now - linkChangeMs > LINK_WAIT_MS / 3) {
      nextMode("no link");
    } else if (confirmed && now - linkChangeMs > LOST_RESCAN_MS) {
      scanStartIdx = modeIdx;
      healthRequired = true;
      nextMode("link lost");
    }
    return;
  }

  if (!ipReady) {                                    // link up but no IP yet (DHCP failed): retry every 30 s
    if (now - linkChangeMs > 30000) { linkChangeMs = now; setupIP(); ensurePhyMode(); }
    return;
  }
  if (usingDHCP) Ethernet.maintain();

  if (!confirmed) {
    if (healthRequired && healthFails >= HEALTH_FAIL_LIMIT) { nextMode("server not reachable"); return; }
    if (healthRequired && !lastServerOK && now - lastHealthTest > 10000) { lastHealthTest = now; healthTest(); }
    if (now - modeStart > STABLE_MS && (!healthRequired || lastServerOK)) {
      confirmed = true;
      dropsInMode = 0;
      prefs.putUChar("phymode", (uint8_t)modeIdx);
      Serial.printf("[LAN] Mode confirmed: %s\n", MODES[modeIdx].name);
    }
  }
}

// =======================================================================
//                               COUNTING
// =======================================================================
void handleCounting(uint32_t now) {
  uint32_t c, lp;
  bool hp;
  portENTER_CRITICAL(&pulseMux);
  c = pulseCount; lp = lastPulseMs; hp = hadPulse;
  portEXIT_CRITICAL(&pulseMux);

  if (c != lastSeenPulses) {
    lastSeenPulses = c;
    digitalWrite(STATUS_LED, HIGH);
    ledOffAt = now + 40;
    if (!running) {
      uint32_t idleDur = idleSince ? (now - idleSince) / 1000 : 0;
      running = true;
      runSince = now;
      pushEvent(EV_RUNNING, idleDur);                // duration = idle time before
    }
    uint32_t blk = c / cfg.sendEvery;
    if (blk != lastBlock) { lastBlock = blk; pushEvent(EV_COUNT, 0); }
  }

  if (running && hp && now - lp >= cfg.idleTimeoutMs) {
    running = false;
    idleSince = now;
    pushEvent(EV_IDLE, (now - runSince) / 1000);     // duration = run time before
  }
  saveCount(false);
}

// "08:00,16:00" -> true if minute-of-day m is in the list
bool isSendTime(int m) {
  int start = 0;
  String s = cfg.sendTimes + ",";
  for (int i = 0; i < (int)s.length(); i++) {
    if (s[i] != ',') continue;
    String t = s.substring(start, i);
    t.trim();
    start = i + 1;
    int c = t.indexOf(':');
    if (c > 0 && t.substring(0, c).toInt() * 60 + t.substring(c + 1).toInt() == m) return true;
  }
  return false;
}

void handleTimers(uint32_t now) {
  if (cfg.heartbeatMin > 0 && now - lastHeartbeat >= cfg.heartbeatMin * 60000UL) {
    lastHeartbeat = now;
    pushEvent(EV_HEARTBEAT, 0);
  }
  if (timeValid) {
    uint32_t local = nowEpoch() + TZ_OFFSET_SEC;
    long epochMin = (long)(local / 60);
    int dayMin = (int)(epochMin % 1440);
    if (epochMin != lastSchedMin && isSendTime(dayMin)) {
      lastSchedMin = epochMin;
      pushEvent(EV_SCHEDULED, 0);
    }
  }
  if (ledOffAt && (int32_t)(now - ledOffAt) >= 0) { digitalWrite(STATUS_LED, LOW); ledOffAt = 0; }
}

