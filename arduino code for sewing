void drawOtaScreen(int pct, unsigned int done, unsigned int total,
                   const String &msg, uint16_t headCol, bool error) {
  spr.fillSprite(TFT_BLACK);                                  // clear
  spr.fillRect(0, 0, SCR_W, 18, headCol);                     // header bar
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_WHITE);
  spr.drawString("FIRMWARE UPDATE", SCR_W / 2, 9, 2);
  spr.setTextColor(TFT_SILVER);
  spr.drawString(MACHINE_ID, SCR_W / 2, 26, 1);

  if (error) {                                                // failure screen
    spr.setTextColor(TFT_RED);
    spr.drawString("UPDATE FAILED", SCR_W / 2, 52, 2);
    spr.setTextColor(TFT_WHITE);
    spr.drawString(msg, SCR_W / 2, 74, 1);                    // reason
    spr.setTextColor(TFT_SILVER);
    spr.drawString("OLD FIRMWARE KEPT", SCR_W / 2, 92, 1);    // ESP32 keeps running the old one
    spr.setTextColor(TFT_DARKGREY);
    spr.drawString("FW " FW_VERSION, SCR_W / 2, 122, 1);
    spr.pushSprite(0, 0);
    return;
  }

  char buf[8];
  snprintf(buf, sizeof(buf), "%d%%", pct);                    // "57%"
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(pct >= 100 ? TFT_GREEN : TFT_WHITE);
  spr.setFreeFont(&FreeSansBold18pt7b);
  spr.drawString(buf, SCR_W / 2, 68);
  spr.setTextFont(1);

  int bx = 8, by = 76, bw = SCR_W - 16, bh = 12;              // progress bar geometry
  uint16_t barCol = (pct >= 100) ? TFT_GREEN : TFT_CYAN;
  spr.drawRoundRect(bx, by, bw, bh, 3, barCol);
  int fill = (bw - 4) * pct / 100;
  if (fill > 0) spr.fillRoundRect(bx + 2, by + 2, fill, bh - 4, 2, barCol);

  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_SILVER);
  if (total > 0)
    spr.drawString(String(done / 1024) + " / " + String(total / 1024) + " KB", SCR_W / 2, 98, 1);

  spr.setTextColor(pct >= 100 ? TFT_GREEN : TFT_ORANGE);
  spr.drawString(msg, SCR_W / 2, 111, 1);
  spr.setTextColor(TFT_DARKGREY);
  spr.drawString("FW " FW_VERSION, SCR_W / 2, 122, 1);
  spr.pushSprite(0, 0);
}

String otaErrorText(ota_error_t e) {                          // OTA error code -> readable text
  if (e == OTA_AUTH_ERROR)    return "WRONG OTA PASSWORD";
  if (e == OTA_BEGIN_ERROR)   return "NO SPACE / PARTITION";
  if (e == OTA_CONNECT_ERROR) return "PC CONNECT FAILED";
  if (e == OTA_RECEIVE_ERROR) return "DATA LOST - RETRY";
  if (e == OTA_END_ERROR)     return "VERIFY FAILED";
  return "ERROR " + String((int)e);
}

void startOTA() {
  ArduinoOTA.setHostname(MACHINE_ID);                         // name seen in Arduino IDE > Port
  ArduinoOTA.setPassword(OTA_PASSWORD);                       // protect uploads

  ArduinoOTA.onStart([]() {                                   // upload begins
    otaInProgress = true;                                     // stop counting/drawing counter
    otaLastPct = -1;
    digitalWrite(buzzerPin, LOW);                             // buzzer off
    drawOtaScreen(0, 0, 0, "DO NOT POWER OFF", TFT_NAVY, false);
  });
  ArduinoOTA.onProgress([](unsigned int done, unsigned int total) {  // each chunk received
    int pct = total ? (int)((uint64_t)done * 100 / total) : 0;
    if (pct != otaLastPct) {                                  // redraw only when % changes
      otaLastPct = pct;
      drawOtaScreen(pct, done, total, "DO NOT POWER OFF", TFT_NAVY, false);
    }
  });
  ArduinoOTA.onEnd([]() {                                     // upload complete
    drawOtaScreen(100, 0, 0, "DONE - RESTARTING...", TFT_DARKGREEN, false);
    delay(1500);                                              // let operator read it; ESP32 then reboots
  });
  ArduinoOTA.onError([](ota_error_t e) {                      // upload failed
    drawOtaScreen(0, 0, 0, otaErrorText(e), TFT_RED, true);
    delay(3000);
    otaInProgress = false;                                    // back to counter screen
    render();
  });

  ArduinoOTA.begin();                                         // start listening
  otaStarted = true;
  flash("OTA READY " + WiFi.localIP().toString(), TFT_CYAN);  // show IP on screen
  Serial.printf("OTA READY: name %s  IP %s\n", MACHINE_ID, WiFi.localIP().toString().c_str());
}

void manageOTA() {                                            // call every loop
  if (WiFi.status() == WL_CONNECTED) {
    if (!otaStarted) startOTA();                              // start once Wi-Fi is up
    ArduinoOTA.handle();                                      // check for upload requests
  } else if (otaStarted) {
    ArduinoOTA.end();                                         // link lost: stop, restart after reconnect
    otaStarted = false;
  }
}

// =====================================================================
// SERVER (compiled only when USE_SERVER is 1)
// =====================================================================
#if USE_SERVER
String jsonStr(const String &js, const char* key) {           // tiny JSON reader: "key":"value" -> value
  String k = String("\"") + key + "\":";                      // look for "key":
  int p = js.indexOf(k);
  if (p < 0) return "";                                       // key missing
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;           // skip spaces
  if (p >= (int)js.length() || js[p] != '"') return "";       // not a string
  int e = js.indexOf('"', p + 1);                             // closing quote
  if (e < 0) return "";
  return js.substring(p + 1, e);                              // text between quotes
}

bool jsonInt(const String &js, const char* key, long &out) {  // tiny JSON reader: "key":123 -> 123
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return false;                                    // key missing
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  out = js.substring(p).toInt();                              // read the number
  return true;
}

// POST the oldest queued event. "age_s" = seconds ago, so the server knows
// the real time even if the event waited offline.
void sendOneEvent() {
  Event &e = queueBuf[qHead];                                 // oldest event
  char id[48];
  snprintf(id, sizeof(id), "%s-%08lX-%lu", MACHINE_ID, (unsigned long)bootId, (unsigned long)e.seq);  // unique ID, e.g. M01-3FA2C1D0-17

  String body = String("{\"device_id\":\"") + MACHINE_ID +
                "\",\"events\":[{\"client_event_id\":\"" + id +
                "\",\"event_type\":\"" + e.type +
                "\",\"job_id\":" + String(e.job) +
                ",\"style_no\":\"" + e.style +
                "\",\"pulses\":" + String(e.pulses) +
                ",\"age_s\":" + String((millis() - e.ms) / 1000) + "}]}";  // JSON body

  HTTPClient http;
  http.setConnectTimeout(3000);                               // give up connecting after 3 s
  http.setTimeout(3000);                                      // give up waiting for reply after 3 s
  http.begin(String(SERVER_URL) + PATH_EVENTS);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Key", DEVICE_KEY);                 // server checks this key
  int code = http.POST(body);
  http.end();

  if ((code >= 200 && code < 300) || code == 409) {           // saved (or already saved) -> remove from queue
    qHead = (qHead + 1) % QUEUE_SIZE;
    qCount--;
  }                                                           // else keep it and retry next sync
}

// Reply from server (job_id = this machine's current assignment):
// {"job_id":12,"style_no":"PM666/01","op_seq":2,"operation":"NECK RIB ATTACH",
//  "q":380,"fg":7,"rej":1,"in":5,"in_mode":"WARN",
//  "n_min":60,"n":70,"n_max":78,"over_action":"REJECT"}
void fetchJob() {
  HTTPClient http;
  http.setConnectTimeout(3000);
  http.setTimeout(3000);
  http.begin(String(SERVER_URL) + PATH_JOB + "?machine=" + MACHINE_ID + "&fw=" FW_VERSION);
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.GET();
  if (code != 200) { http.end(); return; }                    // server down / wrong key: keep current job
  String r = http.getString();                                // reply text
  http.end();

  long jid, q, fg, rej, n, nMin, nMax;
  if (!jsonInt(r, "job_id", jid) || !jsonInt(r, "q", q) || !jsonInt(r, "fg", fg)) return;  // bad reply
  long prevJob = jobId;                                       // to tell a new assignment from an IN update

  if (jid != jobId) {                                         // supervisor assigned a NEW job
    if (pulseCount > 0) return;                               // garment half-sewn: wait until it is removed
    jobId = jid;
    styleNo = jsonStr(r, "style_no");                         // "" when no job
    operationName = jsonStr(r, "operation");
    pulseCount = 0;
    if (styleNo.length() > 0) {                               // tell the operator
      flash("NEW JOB " + styleNo, TFT_CYAN);
      beep(2);
    }
  } else {                                                    // same job: names may have been edited
    styleNo = jsonStr(r, "style_no");
    operationName = jsonStr(r, "operation");
  }

  // stitch limits, checked so a bad value cannot break counting
  if (jsonInt(r, "n", n) && n >= 1 && n <= 250) stitchN = (int)n;
  if (jsonInt(r, "n_min", nMin) && nMin >= 1 && nMin <= stitchN) stitchMin = (int)nMin;
  if (jsonInt(r, "n_max", nMax) && nMax >= stitchN && nMax <= 250) stitchMax = (int)nMax;
  if (stitchMin > stitchN) stitchMin = stitchN;               // keep MIN <= TARGET <= MAX
  if (stitchMax < stitchN) stitchMax = stitchN;
  overAccept = (jsonStr(r, "over_action") == "ACCEPT");       // over-stitch policy

  long op, inW;
  if (jsonInt(r, "op_seq", op)) opSeq = (int)op;             // operation number in the route
  long oldIn = inWaiting;
  if (jsonInt(r, "in", inW)) inWaiting = inW;                 // pieces waiting from previous op
  inBlock = (jsonStr(r, "in_mode") == "BLOCK");               // IN rule for this style
  if (jid == prevJob && opSeq > 1 && inWaiting > oldIn && styleNo.length() > 0 && pulseCount == 0)
    flash("IN +" + String(inWaiting - oldIn) + "  FROM OP" + String(opSeq - 1), TFT_CYAN);  // new piece arrived

  qtyRemaining = q;                                           // server is master for Q, FG, REJ, IN
  finishedFG   = fg;
  if (jsonInt(r, "rej", rej)) rejectCnt = rej;
  render();
}

// Card scanned at this machine -> server links machine to that operation.
// Reply 200 {"ok":true,"op_seq":2,...}   404 = card not registered yet
void sendScan() {
  HTTPClient http;
  http.setConnectTimeout(3000);
  http.setTimeout(3000);
  http.begin(String(SERVER_URL) + PATH_SCAN);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.POST(String("{\"device_id\":\"") + MACHINE_ID + "\",\"card_uid\":\"" + pendingCard + "\"}");
  http.end();
  if (code == 200) {                                          // linked: read the new job straight away
    pendingCard = "";
    fetchJob();
  } else if (code == 404) {                                   // card not known: supervisor must register it
    flash("UNKNOWN CARD " + pendingCard, TFT_RED);
    beep(2);
    pendingCard = "";
  } else if (code == 409) {                                   // style closed / not active
    flash("STYLE NOT ACTIVE", TFT_RED);
    beep(2);
    pendingCard = "";
  }                                                           // other codes (offline): keep it and retry
}

void syncWithServer() {
  if (WiFi.status() != WL_CONNECTED) return;                  // offline: events wait in queue
  if (pendingCard.length() > 0 && qCount == 0) sendScan();    // card first, once old pieces are uploaded
  else if (qCount > 0) sendOneEvent();                        // empty the queue (one per sync)
  else            fetchJob();                                 // then read the job (so counts never jump back)
}
