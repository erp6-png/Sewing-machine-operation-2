void setup() {
  Serial.begin(115200);                                       // USB serial for debug
  pinMode(irPin, INPUT);                                      // IR sensor input
  pinMode(pulsePin, INPUT);                                   // GPIO34 has no internal pull-up: external 10k to 3.3V
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW);                               // buzzer off
  attachInterrupt(digitalPinToInterrupt(pulsePin), onPulse, FALLING);  // pulse HIGH->LOW = one stitch
  Serial2.begin(9600, SERIAL_8N1, rfidRxPin, -1);             // RDM6300: 9600 baud, RX only

  tft.init();                                                 // start display
  tft.setRotation(SCREEN_ROTATION);
  tft.fillScreen(TFT_BLACK);
  spr.createSprite(SCR_W, SCR_H);                             // allocate frame buffer (~40 KB)

  tft.setTextDatum(MC_DATUM);                                 // boot screen
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString("SEWING COUNTER", SCR_W / 2, 50, 2);
  tft.drawString("FW " FW_VERSION, SCR_W / 2, 75, 1);
  tft.drawString("Connecting Wi-Fi...", SCR_W / 2, 95, 1);

  bootId = esp_random();                                      // random ID for this power-on
  connectWiFi(8000);                                          // try Wi-Fi up to 8 s

  Serial.println();
  Serial.printf("=== Sewing Counter FW %s  ID %s ===\n", FW_VERSION, MACHINE_ID);
  Serial.printf("Mode: %s\n", USE_SERVER ? "SERVER (supervisor app)" : "STANDALONE (no server)");
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("WiFi OK: %s  IP %s  RSSI %d dBm\n", WIFI_SSID,
                  WiFi.localIP().toString().c_str(), (int)WiFi.RSSI());
  } else {
    Serial.printf("WiFi NOT connected to \"%s\" - check name/password (2.4 GHz only). Will keep retrying.\n", WIFI_SSID);
  }

#if !USE_SERVER
  styleNo       = LOCAL_STYLE;                                // fixed bench job
  operationName = LOCAL_OPERATION;
  qtyRemaining  = LOCAL_QTY;
  stitchN       = LOCAL_N;
  stitchMin     = min(LOCAL_N_MIN, LOCAL_N);
  stitchMax     = max(LOCAL_N_MAX, LOCAL_N);
  overAccept    = LOCAL_OVER_ACCEPT;
  jobId         = 1;
  opSeq         = 1;                                          // bench test = first operation
  inWaiting     = LOCAL_QTY;                                  // op 1 input = issued quantity
  inBlock       = false;
#endif

  irCandidate = (digitalRead(irPin) == IR_ACTIVE_LEVEL);      // start with the current sensor state
  garmentPresent = irCandidate;
  render();                                                   // first counter screen
}

void loop() {
  manageOTA();                                                // OTA service
  if (otaInProgress) return;                                  // nothing else while updating

  readGarmentSensor();                                        // garment placed/removed? (FG decision here)
  processPulses();                                            // add new stitches
  readRfid();                                                 // operation card scanned?
  keepWiFiAlive();                                            // reconnect if needed

#if USE_SERVER
  // Use the network only when it is safe: no garment, or machine quiet 1.5 s.
  // A slow request must never delay garment detection in the middle of sewing.
  static unsigned long lastSync = 0;
  bool safeToSync = !garmentPresent || (millis() - lastPulseSeenMs > IDLE_BEFORE_SYNC_MS);
  bool cardWaiting = pendingCard.length() > 0 && !garmentPresent;   // card scanned: sync now, don't wait 3 s
  if (safeToSync && (cardWaiting || millis() - lastSync >= SYNC_INTERVAL_MS)) {
    lastSync = millis();
    syncWithServer();                                         // send events / get job + limits from app
  }
#endif

  static unsigned long lastRender = 0;                        // periodic redraw (banner timeout, Wi-Fi bars)
  if (millis() - lastRender >= RENDER_INTERVAL_MS) {
    lastRender = millis();
    render();
  }

  static unsigned long lastDebug = 0;                         // serial status every 2 s (Serial Monitor 115200)
  if (millis() - lastDebug >= 2000) {
    lastDebug = millis();
    Serial.printf("JOB=%ld %s OP%d %s IN=%ld%s IR=%d GARMENT=%s ST=%d (%d/%d/%d) Q=%ld FG=%ld REJ=%ld QUEUE=%d WIFI=%s\n",
                  jobId, styleNo.c_str(), opSeq, operationName.c_str(), inWaiting, inBlock ? "(BLOCK)" : "",
                  digitalRead(irPin), garmentPresent ? "PRESENT" : "ABSENT",
                  pulseCount, stitchMin, stitchN, stitchMax,
                  qtyRemaining, finishedFG, rejectCnt, qCount,
                  WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "OFFLINE");
  }
}
