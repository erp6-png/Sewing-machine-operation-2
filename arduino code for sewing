// ================= PINS =================
const int irPin     = 19;                     // IR garment sensor input
const int pulsePin  = 34;                     // stitch pulse input (via optocoupler)
const int buzzerPin = 22;                     // buzzer output
const int rfidRxPin = 27;                     // RDM6300 TX -> ESP32 RX (Serial2), through a divider
const int IR_ACTIVE_LEVEL = HIGH;             // pin level when garment IS present (flip to LOW if your sensor is opposite)

// ================= TIMING =================
const unsigned long PULSE_DEBOUNCE_US   = 30000;  // pulses closer than 30 ms are noise (max ~2000 stitches/min)
const unsigned long PRESENT_CONFIRM_MS  = 100;    // garment must be seen 100 ms before we believe it
const unsigned long ABSENT_CONFIRM_MS   = 300;    // garment must be gone 300 ms before we decide FG/reject
const unsigned long RENDER_INTERVAL_MS  = 150;    // redraw screen at most ~6 times per second
const unsigned long FLASH_MS            = 2500;   // how long a result banner stays on screen
const unsigned long WIFI_RETRY_MS       = 15000;  // try to reconnect Wi-Fi every 15 s when it drops
const unsigned long CARD_REPEAT_MS      = 3000;   // same card held on the reader is read again only after 3 s
#if USE_SERVER                                     // timing used only with a server
const unsigned long SYNC_INTERVAL_MS    = 3000;   // talk to server every 3 s -> app changes show within ~3 s
const unsigned long IDLE_BEFORE_SYNC_MS = 1500;   // machine must be quiet 1.5 s before using the network
#endif                                             // end of server-only timing

// ================= JOB (set by supervisor app) =================
long   jobId        = 0;      // server's job number; changes when supervisor assigns a NEW job
String styleNo      = "";     // style number, e.g. PM666/01 ("" = no job)
String operationName = "";    // operation name, e.g. SIDE SEAM
int    stitchMin    = 40;     // MIN stitches: below this = SHORT reject
int    stitchN      = 50;     // TARGET stitches: correct operation, operator told to remove
int    stitchMax    = 55;     // MAX stitches: above this = OVER
bool   overAccept   = false;  // what to do with OVER pieces: false = reject, true = count as FG
long   qtyRemaining = 0;      // Q: pieces still to make
long   finishedFG   = 0;      // FG: good pieces done
long   rejectCnt    = 0;      // REJ: short + over rejects (this machine)
int    opSeq        = 0;      // operation number in the style route (1 = first)
long   inWaiting    = 0;      // IN: pieces waiting from the previous operation (shared by the op)
bool   inBlock      = false;  // true = BLOCK mode: no counting while IN is 0

// ================= RFID =================
String pendingCard  = "";     // card read, waiting to be sent to the server
String lastCard     = "";     // last card seen (to ignore the same card held on the reader)
unsigned long lastCardMs = 0; // when lastCard was read
uint8_t rfidBuf[14];          // RDM6300 frame: 0x02, 10 data chars, 2 checksum chars, 0x03
int     rfidLen = 0;          // bytes collected so far

// ================= LIVE COUNT =================
int  pulseCount = 0;                 // stitches on the garment that is under the needle now
bool garmentPresent = false;         // confirmed (debounced) garment state
bool irCandidate = false;            // last raw IR reading, waiting to be confirmed
unsigned long irCandidateSince = 0;  // when the raw IR reading last changed
unsigned long lastPulseSeenMs = 0;   // time of the last stitch (used to know the machine is idle)

// ================= OTA STATE =================
bool otaStarted = false;     // OTA service running?
bool otaInProgress = false;  // a firmware upload is happening right now?
int  otaLastPct = -1;        // last % drawn, so the screen is redrawn only when % changes

// ================= PULSE INTERRUPT =================
volatile uint32_t isrPulses = 0;     // pulses counted by the interrupt, not yet processed by loop()
volatile uint32_t lastPulseUs = 0;   // time of the last accepted pulse (microseconds)

void IRAM_ATTR onPulse() {                          // runs instantly on every falling edge of GPIO34 (kept in RAM = fast)
  uint32_t now = micros();                          // current time in microseconds
  if (now - lastPulseUs > PULSE_DEBOUNCE_US) {      // far enough from the previous pulse? (else it is bounce/noise)
    isrPulses++;                                    // count one stitch
    lastPulseUs = now;                              // remember when
  }
}

// ================= EVENT QUEUE (only used with a server) =================
// Every finished/rejected piece becomes an "event". Events wait here until
// the server confirms it saved them, so nothing is lost if Wi-Fi drops.
struct Event {
  const char*   type;      // "OP_DONE" (good), "OP_SHORT" (below MIN), "OP_OVER" (above MAX, rejected)
  uint8_t       pulses;    // stitch count of that piece
  uint32_t      seq;       // running number -> unique ID so the server never counts it twice
  uint32_t      job;       // job number the piece belongs to
  unsigned long ms;        // millis() when it happened (server converts to real time)
  char          style[16]; // style number at that moment
};
const int QUEUE_SIZE = 100;          // up to 100 pieces can wait offline
Event queueBuf[QUEUE_SIZE];          // ring buffer storage
int qHead = 0, qCount = 0;           // qHead = oldest event, qCount = how many waiting
uint32_t eventSeq = 0;               // last used sequence number
uint32_t bootId = 0;                 // random per power-on; makes event IDs unique across reboots

void queueEvent(const char* type, uint8_t pulses) {
#if USE_SERVER
  if (qCount >= QUEUE_SIZE) {                                  // queue full (server offline very long)
    Serial.println("EVENT QUEUE FULL - event dropped");         // report it
    return;                                                    // drop the newest event
  }
  Event &e = queueBuf[(qHead + qCount) % QUEUE_SIZE];          // next free slot in the ring
  e.type = type;                                               // store event type
  e.pulses = pulses;                                           // store stitch count
  e.seq = ++eventSeq;                                          // new sequence number
  e.job = (uint32_t)jobId;                                     // which job
  e.ms = millis();                                             // when
  strncpy(e.style, styleNo.c_str(), sizeof(e.style));          // copy style text
  e.style[sizeof(e.style) - 1] = 0;                            // make sure it is terminated
  qCount++;                                                    // one more waiting
#else
  (void)type; (void)pulses;                                    // standalone: nothing to send (silences warnings)
#endif
}

// ================= BANNER (result flash) =================
String        flashText = "";          // banner text
uint16_t      flashColor = TFT_GREEN;  // banner colour
unsigned long flashUntil = 0;          // time when banner disappears

void flash(const String &t, uint16_t col) {   // show a banner for FLASH_MS
  flashText = t;                               // set text
  flashColor = col;                            // set colour
  flashUntil = millis() + FLASH_MS;            // set end time
}

// ================= BUZZER =================
void beep(int times) {                                   // short beeps (blocks ~140 ms per beep; stitches are still counted by the interrupt)
  for (int i = 0; i < times; i++) {                      // repeat
    digitalWrite(buzzerPin, HIGH); delay(70);            // on 70 ms
    digitalWrite(buzzerPin, LOW);  delay(70);            // off 70 ms
  }
}

// =====================================================================
// DRAWING
// =====================================================================
String fitText(const String &s, int maxW, int font) {    // cut text so it fits in maxW pixels
  String t = s;                                          // working copy
  while (t.length() > 0 && spr.textWidth(t, font) > maxW) t.remove(t.length() - 1);  // drop last char until it fits
  return t;                                              // fitted text
}

int wifiBars() {                                         // Wi-Fi strength as 0..4 bars, -1 = not connected
  if (WiFi.status() != WL_CONNECTED) return -1;          // no link
  long rssi = WiFi.RSSI();                               // signal in dBm (closer to 0 = stronger)
  if (rssi > -55) return 4;                              // excellent
  if (rssi > -65) return 3;                              // good
  if (rssi > -75) return 2;                              // fair
  if (rssi > -85) return 1;                              // weak
  return 0;                                              // very weak
}

void drawWiFiBars(int x, int yb) {                       // draw 4 bars, bottom edge at yb
  int bars = wifiBars();                                 // current strength
  for (int i = 0; i < 4; i++) {                          // each bar
    int h = 3 + i * 3;                                   // heights 3,6,9,12
    uint16_t col = (bars > i) ? TFT_GREEN : TFT_DARKGREY;// lit or dim
    spr.fillRect(x + i * 4, yb - h + 1, 3, h, col);      // draw bar
  }
  if (bars < 0) {                                        // not connected: red X over the bars
    spr.drawLine(x, yb - 11, x + 14, yb, TFT_RED);
    spr.drawLine(x, yb, x + 14, yb - 11, TFT_RED);
  }
}

void drawBox(int x, int y, int w, int h, const char* label,   // small counter box at the bottom
             long value, uint16_t col, bool active) {
  spr.fillRoundRect(x, y, w, h, 4, active ? col : 0x18E3);    // fill: colour when flashing, dark grey otherwise
  spr.drawRoundRect(x, y, w, h, 4, col);                      // outline
  spr.fillRect(x + 2, y + 2, w - 4, 10, active ? TFT_WHITE : col);  // label strip

  spr.setTextDatum(MC_DATUM);                                 // text anchored at middle-centre
  spr.setTextColor(TFT_BLACK);                                // black label text
  spr.drawString(label, x + w / 2, y + 7, 1);                 // label

  char buf[12];                                               // number as text
  snprintf(buf, sizeof(buf), "%ld", value);
  int cy = y + h - 4;                                         // baseline for the number
  spr.setTextDatum(C_BASELINE);                               // anchor at centre of baseline
  spr.setTextColor(active ? TFT_BLACK : col);                 // number colour
  spr.setFreeFont(&FreeSansBold12pt7b);                       // big bold font
  if (spr.textWidth(buf) <= w - 6) {                          // fits?
    spr.drawString(buf, x + w / 2, cy);                       // draw big
  } else {
    spr.setTextFont(2);                                       // too wide: smaller font
    spr.drawString(buf, x + w / 2, cy);
  }
  spr.setTextFont(1);                                         // back to default font
}

void statusStrip(int sy, int sh, uint16_t bg, uint16_t fg, const char* txt) {  // one-colour status line
  spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, bg);             // background
  spr.setTextDatum(MC_DATUM);                                 // centre text
  spr.setTextColor(fg);                                       // text colour
  spr.drawString(txt, SCR_W / 2, sy + sh / 2 + 1, 1);         // text
}

void render() {
  if (otaInProgress) return;                                  // OTA screen owns the display during update
  spr.fillSprite(TFT_BLACK);                                  // clear buffer
  char buf[28];                                               // scratch text
  bool flashing = (flashText.length() > 0 && millis() < flashUntil);  // banner active?
  bool hasJob = (styleNo.length() > 0);                       // job assigned?

  // ===== HEADER (y 0..17): machine ID, Wi-Fi, fabric state =====
  spr.fillRect(0, 0, SCR_W, 18, TFT_NAVY);                    // blue header bar
  spr.setTextDatum(ML_DATUM);                                 // anchor middle-left
  spr.setTextColor(TFT_SILVER);
  spr.drawString("MC", 3, 9, 1);                              // "MC" label
  spr.setTextColor(TFT_WHITE);
  spr.drawString(MACHINE_ID, 20, 9, 2);                       // machine ID

  const char* gtxt = garmentPresent ? "FABRIC" : "NO FABRIC"; // fabric pill text
  int pw = spr.textWidth(gtxt, 1) + 10;                       // pill width
  int px = SCR_W - pw - 3;                                    // pill x (right side)
  spr.fillRoundRect(px, 3, pw, 12, 6, garmentPresent ? TFT_GREEN : TFT_YELLOW);  // pill
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_BLACK);
  spr.drawString(gtxt, px + pw / 2, 9, 1);                    // pill text
  drawWiFiBars(px - 20, 15);                                  // Wi-Fi bars left of the pill
  if (qCount > 0) spr.fillCircle(px - 27, 9, 3, TFT_ORANGE);  // orange dot = pieces waiting to upload

  // ===== JOB ROW (y 19..31): style left, operation right =====
  spr.setTextDatum(ML_DATUM);                                 // style anchored left
  spr.setTextColor(TFT_ORANGE);
  String st = hasJob ? styleNo : String("NO JOB");            // style text
  spr.drawString(fitText(st, 76, 2), 3, 25, 2);               // style, max 76 px wide
  spr.setTextDatum(MR_DATUM);                                 // operation anchored right
  spr.setTextColor(TFT_CYAN);
  String opTxt = hasJob ? ("OP" + String(opSeq) + " " + operationName) : String("");  // e.g. "OP2 NECK RIB"
  spr.drawString(fitText(opTxt, 76, 1), SCR_W - 3, 25, 1);   // operation, max 76 px

  // ===== BIG CARD (y 33..78): FINISHED FG =====
  uint16_t border = flashing ? flashColor : TFT_GREEN;        // border follows banner colour
  spr.fillRoundRect(2, 33, SCR_W - 4, 46, 6, 0x0180);         // dark green card
  spr.drawRoundRect(2, 33, SCR_W - 4, 46, 6, border);         // double border
  spr.drawRoundRect(3, 34, SCR_W - 6, 44, 5, border);

  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(TFT_GREEN);
  spr.drawString("FINISHED (FG)", 8, 40, 1);                  // card title
  spr.setTextDatum(MR_DATUM);
  spr.setTextColor(TFT_SILVER);
  snprintf(buf, sizeof(buf), "%d-%d-%d", stitchMin, stitchN, stitchMax);  // limits MIN-TARGET-MAX
  spr.drawString(buf, SCR_W - 8, 40, 1);                      // shown top-right of card

  snprintf(buf, sizeof(buf), "%ld", finishedFG);              // FG number
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(TFT_WHITE);
  spr.setFreeFont(&FreeSansBold24pt7b);                       // huge font
  if (spr.textWidth(buf) > SCR_W - 16) spr.setFreeFont(&FreeSansBold18pt7b);  // smaller if too wide
  spr.drawString(buf, SCR_W / 2, 74);                         // draw FG
  spr.setTextFont(1);

  // ===== STATUS STRIP (y 81..93) =====
  int sy = 81, sh = 13;                                       // strip position/height
  if (flashing) {                                             // 1) result banner has priority
    statusStrip(sy, sh, flashColor, TFT_BLACK, flashText.c_str());
  } else if (!hasJob) {                                       // 2) nothing assigned
    statusStrip(sy, sh, 0x18E3, TFT_SILVER, "SCAN OPERATION CARD");
  } else if (inBlock && inWaiting <= 0 && pulseCount == 0) {  // 2b) BLOCK mode and nothing came from previous op
    statusStrip(sy, sh, TFT_ORANGE, TFT_BLACK, "WAITING FOR PIECES");
  } else if (qtyRemaining <= 0 && pulseCount == 0) {          // 3) quantity finished
    statusStrip(sy, sh, TFT_GREEN, TFT_BLACK, "JOB DONE");
  } else if (garmentPresent && pulseCount > stitchMax) {      // 4) above MAX
    snprintf(buf, sizeof(buf), "OVER %d/%d - REMOVE", pulseCount, stitchMax);
    statusStrip(sy, sh, overAccept ? TFT_ORANGE : TFT_RED, TFT_BLACK, buf);
  } else if (garmentPresent && pulseCount >= stitchN) {       // 5) TARGET reached
    snprintf(buf, sizeof(buf), "TARGET %d - REMOVE", pulseCount);
    statusStrip(sy, sh, TFT_GREEN, TFT_BLACK, buf);
  } else if (garmentPresent) {                                // 6) sewing: progress bar 0..MAX
    bool okZone = (pulseCount >= stitchMin);                  // reached MIN?
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, 0x18E3);       // bar background
    int barW = SCR_W - 8;                                     // usable bar width
    int fillW = barW * min(pulseCount, stitchMax) / max(stitchMax, 1);  // filled part
    if (fillW > 0) spr.fillRoundRect(4, sy + 2, fillW, sh - 4, 2, okZone ? 0x07E0 : 0x03A0);  // dark green < MIN, bright green >= MIN
    spr.drawFastVLine(4 + barW * stitchMin / max(stitchMax, 1), sy + 1, sh - 2, TFT_YELLOW);  // MIN marker (yellow)
    spr.drawFastVLine(4 + barW * stitchN   / max(stitchMax, 1), sy + 1, sh - 2, TFT_WHITE);   // TARGET marker (white)
    spr.setTextDatum(MC_DATUM);
    spr.setTextColor(okZone ? TFT_BLACK : TFT_WHITE);
    if (okZone) snprintf(buf, sizeof(buf), "STITCH %d/%d  OK", pulseCount, stitchN);
    else        snprintf(buf, sizeof(buf), "STITCH %d/%d MIN %d", pulseCount, stitchN, stitchMin);
    spr.drawString(buf, SCR_W / 2, sy + sh / 2 + 1, 1);
  } else {                                                    // 7) idle, waiting for garment
    statusStrip(sy, sh, 0x18E3, TFT_YELLOW, "PLACE GARMENT");
  }

  // ===== COUNT BOXES (y 95..127): QTY / REJ / IN =====
  int by = 95, bh = SCR_H - by, gap = 2;                      // box row geometry
  int bw = (SCR_W - 2 * gap) / 3;                             // 3 equal boxes
  drawBox(0,              by, bw, bh, "QTY", hasJob ? qtyRemaining : 0, TFT_CYAN,
          flashing && flashColor == TFT_GREEN);               // QTY lights up on FG
  drawBox(bw + gap,       by, bw, bh, "REJ", rejectCnt, TFT_RED,
          flashing && flashColor == TFT_RED);                 // REJ lights up on reject
  drawBox(2 * (bw + gap), by, bw, bh, "IN",  hasJob ? max(inWaiting, 0L) : 0, TFT_YELLOW,
          flashing && flashColor == TFT_CYAN);                // IN: pieces waiting from previous op (TARGET shown on the card)

  spr.pushSprite(0, 0);                                       // send buffer to screen in one go
}

// =====================================================================
// SENSORS / COUNTING
// =====================================================================
// The decision is made ONLY here, when the garment leaves the machine.
void onGarmentRemoved() {
  if (pulseCount == 0) { render(); return; }                  // no stitches: garment just moved, ignore

  if (pulseCount < stitchMin) {                               // ---- SHORT: below MIN ----
    rejectCnt++;                                              // reject +1
    queueEvent("OP_SHORT", (uint8_t)pulseCount);              // report to server
    flash("SHORT " + String(pulseCount) + "/" + String(stitchMin) + " REJECT", TFT_RED);
    Serial.printf("SHORT at %d (min %d)  REJ=%ld\n", pulseCount, stitchMin, rejectCnt);
    beep(2);                                                  // 2 beeps = rejected
  } else if (pulseCount <= stitchMax || overAccept) {         // ---- GOOD (or over but accepted) ----
    finishedFG++;                                             // FG +1
    if (qtyRemaining > 0) qtyRemaining--;                     // Q -1
    bool hadInput = (inWaiting > 0);                          // was a piece waiting from the previous op?
    if (inWaiting > 0) inWaiting--;                           // IN -1 (server confirms on next sync)
    queueEvent("OP_DONE", (uint8_t)min(pulseCount, 255));     // report (server sees pulses > max = over-accepted)
    if (!hadInput && opSeq > 1)  flash("FG +1  NO INPUT!", TFT_ORANGE);              // WARN mode: counted without input
    else if (pulseCount > stitchMax) flash("FG +1  OVER " + String(pulseCount), TFT_ORANGE);  // accepted but flagged
    else                        flash("FG +1   (" + String(pulseCount) + " ST)", TFT_GREEN);
    Serial.printf("FG at %d st  Q=%ld FG=%ld\n", pulseCount, qtyRemaining, finishedFG);
    beep(1);                                                  // 1 beep = good
  } else {                                                    // ---- OVER: above MAX, rejected ----
    rejectCnt++;                                              // reject +1
    queueEvent("OP_OVER", (uint8_t)min(pulseCount, 255));     // report
    flash("OVER " + String(pulseCount) + "/" + String(stitchMax) + " REJECT", TFT_RED);
    Serial.printf("OVER at %d (max %d)  REJ=%ld\n", pulseCount, stitchMax, rejectCnt);
    beep(2);                                                  // 2 beeps = rejected
  }
  pulseCount = 0;                                             // ready for the next garment
  render();                                                   // show result immediately
}

void readGarmentSensor() {
  bool raw = (digitalRead(irPin) == IR_ACTIVE_LEVEL);         // raw reading: true = garment seen
  if (raw != irCandidate) {                                   // reading changed:
    irCandidate = raw;                                        //   remember new value
    irCandidateSince = millis();                              //   start timing it
    return;
  }
  if (raw == garmentPresent) return;                          // nothing new

  unsigned long needed = raw ? PRESENT_CONFIRM_MS : ABSENT_CONFIRM_MS;  // how long it must stay
  if (millis() - irCandidateSince >= needed) {                // stable long enough -> accept
    garmentPresent = raw;
    if (!garmentPresent) onGarmentRemoved();                  // removed -> decide FG/reject
    else render();                                            // placed -> update screen
  }
}

void processPulses() {
  noInterrupts();                                             // pause interrupt while reading the shared counter
  uint32_t n = isrPulses;                                     // take the pulses
  isrPulses = 0;                                              // reset
  interrupts();                                               // resume
  if (n == 0) return;                                         // no stitches since last time
  lastPulseSeenMs = millis();                                 // machine is running

  bool changed = false;
  while (n--) {                                               // handle each stitch
    bool inputOk = !inBlock || inWaiting > 0 || pulseCount > 0;   // BLOCK mode: need a waiting piece to start
    if (garmentPresent && qtyRemaining > 0 && styleNo.length() > 0 && inputOk) {  // garment + job + qty left + input
      if (pulseCount < 255) pulseCount++;                     // +1 stitch (cap fits in 1 byte)
      changed = true;
      if (pulseCount == stitchN) {                            // TARGET reached
        Serial.printf("TARGET %d - remove garment\n", pulseCount);
        beep(1);
      }
      if (pulseCount == stitchMax + 1) {                      // just crossed MAX
        Serial.printf("OVER LIMIT %d > %d\n", pulseCount, stitchMax);
        flash("OVER LIMIT - REMOVE", overAccept ? TFT_ORANGE : TFT_RED);
        beep(3);                                              // 3 beeps = warning
      }
    }
    // no garment / no job / qty done / BLOCK with IN 0: pulse ignored (e.g. machine test-run)
  }
  if (changed) render();                                      // show new stitch count
}

// =====================================================================
// RFID (RDM6300, 125 kHz, 9600 baud)
// Frame: 0x02 | 10 ASCII hex (card ID) | 2 ASCII hex checksum | 0x03
// Checksum = XOR of the 5 data bytes.
// =====================================================================
int hexVal(uint8_t c) {                                       // '0'..'9','A'..'F' -> 0..15, -1 = not hex
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  return -1;
}

void onCardRead(const String &uid) {                          // a valid card was read
  if (uid == lastCard && millis() - lastCardMs < CARD_REPEAT_MS) {  // same card still on the reader
    lastCardMs = millis();
    return;
  }
  lastCard = uid;
  lastCardMs = millis();
  Serial.printf("CARD %s\n", uid.c_str());
  if (pulseCount > 0) {                                       // half-sewn garment: never change job now
    flash("REMOVE PIECE FIRST", TFT_ORANGE);
    beep(3);
    return;
  }
#if USE_SERVER
  pendingCard = uid;                                          // sent at the next safe sync (right away when idle)
  flash("CARD " + uid, TFT_CYAN);
  beep(1);
#else
  flash("CARD " + uid + " (NO SERVER)", TFT_CYAN);            // standalone: show the ID so it can be registered
  beep(1);
#endif
}

void readRfid() {                                             // collect bytes; call every loop
  while (Serial2.available()) {
    uint8_t c = Serial2.read();
    if (c == 0x02) { rfidLen = 0; }                           // start of a frame
    if (rfidLen < (int)sizeof(rfidBuf)) rfidBuf[rfidLen++] = c;
    if (c == 0x03 && rfidLen == 14) {                         // full frame received
      uint8_t sum = 0;
      bool ok = true;
      for (int i = 0; i < 6 && ok; i++) {                     // 5 data bytes + checksum byte
        int hi = hexVal(rfidBuf[1 + i * 2]), lo = hexVal(rfidBuf[2 + i * 2]);
        if (hi < 0 || lo < 0) { ok = false; break; }
        uint8_t b = (hi << 4) | lo;
        if (i < 5) sum ^= b; else ok = (sum == b);            // checksum check
      }
      if (ok) {
        char uid[11];
        for (int i = 0; i < 10; i++) uid[i] = toupper(rfidBuf[1 + i]);
        uid[10] = 0;
        onCardRead(String(uid));
      }
      rfidLen = 0;
    } else if (c == 0x03) {
      rfidLen = 0;                                            // broken frame: start again
    }
  }
}

// =====================================================================
// WIFI
// =====================================================================
void connectWiFi(unsigned long timeoutMs) {                   // blocking connect at boot only
  WiFi.mode(WIFI_STA);                                        // station (client) mode
  WiFi.setSleep(false);                                       // no power-save: faster, more reliable replies
  WiFi.begin(WIFI_SSID, WIFI_PASS);                           // start connecting
  unsigned long t = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t < timeoutMs) delay(200);  // wait up to timeout
}

void keepWiFiAlive() {                                        // non-blocking reconnect while running
  static unsigned long lastTry = 0;                           // last attempt time
  if (WiFi.status() == WL_CONNECTED) return;                  // all good
  if (millis() - lastTry < WIFI_RETRY_MS) return;             // not time yet
  lastTry = millis();
  Serial.printf("WiFi not connected - retrying \"%s\"...\n", WIFI_SSID);
  WiFi.disconnect();                                          // reset the radio state
  WiFi.begin(WIFI_SSID, WIFI_PASS);                           // try again (runs in background)
}

