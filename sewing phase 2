  spr.fillSprite(TFT_BLACK);
  bool flashing = (flashText.length() > 0 && millis() < flashUntil);
  bool hasJob = (jobState == "ready");

  // ---------- HEADER: MC  <machine label or pending hw_id>  STYLE ....  [FABRIC] ----------
