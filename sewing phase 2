#if USE_SERVER
String jsonStr(const String &js, const char* key) {
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return "";
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  if (p >= (int)js.length() || js[p] != '"') return "";
  int e = js.indexOf('"', p + 1);
  if (e < 0) return "";
  return js.substring(p + 1, e);
}

bool jsonInt(const String &js, const char* key, long &out) {
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return false;
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  out = js.substring(p).toInt();
  return true;
}

void sendOneEvent() {
  Event &e = queueBuf[qHead];
  char id[48];
  snprintf(id, sizeof(id), "%s-%08lX-%lu", MACHINE_ID, (unsigned long)bootId, (unsigned long)e.seq);

  String body = String("{\"device_id\":\"") + MACHINE_ID +
                "\",\"events\":[{\"client_event_id\":\"" + id +
                "\",\"event_type\":\"" + e.type +
                "\",\"style_no\":\"" + e.style +
                "\",\"pulses\":" + String(e.pulses) +
                ",\"age_s\":" + String((millis() - e.ms) / 1000) + "}]}";

  HTTPClient http;
  http.setConnectTimeout(3000);
  http.setTimeout(3000);
  http.begin(String(SERVER_URL) + PATH_EVENTS);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.POST(body);
  http.end();

  if ((code >= 200 && code < 300) || code == 409) {
    qHead = (qHead + 1) % QUEUE_SIZE;
    qCount--;
    requestRender();
  }
}

void fetchJob() {
  HTTPClient http;
  http.setConnectTimeout(3000);
  http.setTimeout(3000);
  http.begin(String(SERVER_URL) + PATH_JOB + "?machine=" + MACHINE_ID);
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.GET();
  if (code != 200) { http.end(); return; }
  String r = http.getString();
  http.end();

  String s = jsonStr(r, "style_no");
  long q, fg, n, nMin;
  if (!jsonInt(r, "q", q) || !jsonInt(r, "fg", fg)) return;

  if (s != styleNo) {
    styleNo = s;
    pulseCount = 0;
    pulseRemainder = 0;
    discardedCnt = 0;
  }
  if (jsonInt(r, "n", n) && n >= 1 && n <= 200) stitchN = (int)n;
  if (jsonInt(r, "n_min", nMin) && nMin >= 1 && nMin <= stitchN) stitchMin = (int)nMin;
  if (stitchMin > stitchN) stitchMin = stitchN;
  qtyRemaining = q;
  finishedFG   = fg;
  requestRender();
}

void syncWithServer() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (qCount > 0) sendOneEvent();
  else            fetchJob();
}
