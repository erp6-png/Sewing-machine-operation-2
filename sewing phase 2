// ================= STITCH INTERRUPT (re-arm logic) =================
volatile uint32_t isrPulses   = 0;
volatile uint32_t isrRejected = 0;
volatile uint32_t lastHighUs  = 0;
volatile uint32_t lastCountUs = 0;
volatile uint32_t isrMinGapUs = 0xFFFFFFFF;

void IRAM_ATTR onPulse() {
  uint32_t now = micros();
  bool high = (REG_READ(GPIO_IN1_REG) >> (PULSE_GPIO - 32)) & 1;
  if (high) {                               // magnet left: start idle timer
    lastHighUs = now;
    return;
  }
  // falling edge = magnet arrived
  if ((now - lastHighUs) < STITCH_REARM_US ||
      (now - lastCountUs) < STITCH_LOCKOUT_US) {
    isrRejected++;
    return;
  }
  if (lastCountUs) {
    uint32_t gap = now - lastCountUs;
    if (gap < isrMinGapUs) isrMinGapUs = gap;
  }
  lastCountUs = now;
  isrPulses++;
}

// ================= EVENT QUEUE =================
struct Event {
  const char*   type;
  uint8_t       pulses;
  uint32_t      seq;
  unsigned long ms;
  char          style[16];
};
const int QUEUE_SIZE = 40;
Event queueBuf[QUEUE_SIZE];
int qHead = 0, qCount = 0;
uint32_t eventSeq = 0;
uint32_t bootId = 0;

void queueEvent(const char* type, uint8_t pulses) {
#if USE_SERVER
  if (qCount >= QUEUE_SIZE) return;
  Event &e = queueBuf[(qHead + qCount) % QUEUE_SIZE];
  e.type = type;
  e.pulses = pulses;
  e.seq = ++eventSeq;
  e.ms = millis();
  strncpy(e.style, styleNo.c_str(), sizeof(e.style));
  e.style[sizeof(e.style) - 1] = 0;
  qCount++;
#else
  (void)type; (void)pulses;
#endif
}

