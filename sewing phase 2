  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(COL_LABEL);
  spr.drawString("STITCHES", cx, 38, 1);
  drawStitchRing(cx, cy, 25, 19);

  char minBuf[16];
  snprintf(minBuf, sizeof(minBuf), "MIN %d/%d", stitchMin, stitchN);
  if (spr.textWidth(minBuf, 1) > 58) snprintf(minBuf, sizeof(minBuf), "%d/%d", stitchMin, stitchN);
  spr.setTextColor(COL_AMBER);
  spr.drawString(minBuf, cx, 103, 1);

  // ---------- RIGHT: FINISHED (FG) CARD ----------
  const int fx = 60, fy = 35, fw = SCR_W - 3 - fx, fh = 48;
  uint16_t border = flashing ? flashColor : COL_ACCENT;
  spr.fillRoundRect(fx, fy, fw, fh, 6, COL_FG_BG);
  spr.drawRoundRect(fx, fy, fw, fh, 6, border);
  spr.drawRoundRect(fx + 1, fy + 1, fw - 2, fh - 2, 5, border);
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(COL_ACCENT);
  spr.drawString("FINISHED (FG)", fx + 6, fy + 8, 1);

  char fgBuf[12];
  snprintf(fgBuf, sizeof(fgBuf), "%ld", finishedFG);
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(TFT_WHITE);
  spr.setFreeFont(&FreeSansBold18pt7b);
  if (spr.textWidth(fgBuf) > fw - 8) spr.setFreeFont(&FreeSansBold12pt7b);
  spr.drawString(fgBuf, fx + fw / 2, fy + fh - 5);
  spr.setTextFont(1);

  // ---------- RIGHT: SIZE / DISC / N ----------
  // The old "QTY" box (server-side quantity remaining) doesn't exist in the
  // IoT clone yet -- repurposed to show which SIZE the stitch target came
  // from (amber if it's the smallest-size fallback, not an exact match for
  // the piece actually on the machine).
  const int by = 86, bh = 24, gap = 2;
  int bw = (fw - 2 * gap) / 3;
  drawBox(fx, by, bw, bh, "SIZE", hasJob ? sizeUsed : String("-"),
          sizeWasFallback ? COL_RING : COL_ACCENT, sizeWasFallback ? COL_RING : COL_ACCENT,
          flashing && flashColor == TFT_GREEN);
  drawBox(fx + bw + gap, by, bw, bh, "DISC", discardedCnt,
          COL_DISC, COL_DISC, flashing && flashColor == TFT_RED);
  drawBox(fx + 2 * (bw + gap), by, fx + fw - (fx + 2 * (bw + gap)), bh, "N", (long)stitchN,
          COL_AMBER, COL_AMBER, false);

  // ---------- STATUS BAR ----------
  if (flashing) {
    drawStatus(flashColor, TFT_BLACK, flashText.c_str());
  } else if (deviceKey.length() == 0) {
    drawStatus(COL_PANEL, COL_AMBER, "WAITING FOR APPROVAL");
  } else if (jobState == "inactive") {
    drawStatus(TFT_RED, TFT_WHITE, "DEVICE DEACTIVATED");
  } else if (jobState == "no_open_run") {
    drawStatus(COL_PANEL, COL_LABEL, "NO OPEN RUN ON THIS LINE");
  } else if (jobState == "waiting_to_be_mapped") {
    drawStatus(COL_PANEL, COL_LABEL, "WAITING TO BE MAPPED");
  } else if (jobState == "no_operations_master_row") {
    drawStatus(COL_PANEL, COL_AMBER, "NO OPERATIONS DATA");
  } else if (garmentPresent && pulseCount >= stitchN) {
    drawStatus(COL_GOOD, TFT_BLACK, "COMPLETE - REMOVE");
  } else if (garmentPresent && pulseCount >= stitchMin) {
    drawStatus(COL_PANEL, COL_GOOD, "MIN OK - CAN REMOVE");
  } else if (garmentPresent) {
    drawStatus(COL_PANEL, TFT_WHITE, "KEEP SEWING");
  } else {
    drawStatus(COL_PANEL, COL_AMBER, "PLACE GARMENT");
  }

  spr.pushSprite(0, 0);
}

