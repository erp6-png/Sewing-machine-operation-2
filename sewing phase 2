void onGarmentRemoved() {
  if (pulseCount >= stitchMin && qtyRemaining > 0) {
    finishedFG++;
    qtyRemaining--;
    queueEvent("OP_DONE", (uint8_t)min(pulseCount, 255));
    flash("FG +1   (" + String(pulseCount) + " ST)", TFT_GREEN);
    Serial.printf("FG COUNTED at %d st  Q=%ld FG=%ld\n", pulseCount, qtyRemaining, finishedFG);
  } else if (pulseCount > 0 && pulseCount < stitchMin) {
    discardedCnt++;
    queueEvent("OP_DISCARD", (uint8_t)pulseCount);
    flash("DISCARDED " + String(pulseCount) + "/" + String(stitchMin), TFT_RED);
    Serial.printf("DISCARDED at %d (min %d)  DISC=%ld\n", pulseCount, stitchMin, discardedCnt);
  }
  pulseCount = 0;
  pulseRemainder = 0;
  requestRender();
}

void readGarmentSensor() {
  int level = digitalRead(irPin);
  if (level != irLastRaw) {
    if (irLastRaw >= 0) irRawChanges++;
    irLastRaw = level;
  }

  bool raw = (level == irActiveLevel);
  unsigned long now = millis();
  if (raw != irCandidate) {
    irCandidate = raw;
    irCandidateSince = now;
    return;
  }
  if (raw == garmentPresent) return;

  if (raw) {
    if (now - irCandidateSince >= PRESENT_CONFIRM_MS) {
      garmentPresent = true;
      Serial.println("FABRIC -> PRESENT");
      requestRender();
    }
  } else {
    if (now - lastPulseMs < STITCH_HOLD_MS) return;
    unsigned long since = (irCandidateSince > lastPulseMs) ? irCandidateSince : lastPulseMs;
    if (now - since >= ABSENT_CONFIRM_MS) {
      garmentPresent = false;
      Serial.println("FABRIC -> ABSENT (removed)");
      onGarmentRemoved();
    }
  }
}

void calibrateIr() {
  if (!IR_AUTO_POLARITY) { irActiveLevel = IR_ACTIVE_LEVEL; irCalOk = false; return; }

  bootLine("Fabric sensor check -", 100, TFT_YELLOW);
  bootLine("keep sensor area CLEAR", 112, TFT_YELLOW);

  uint32_t highs = 0, samples = 0;
  unsigned long t0 = millis();
  while (millis() - t0 < IR_CAL_MS) {
    if (digitalRead(irPin) == HIGH) highs++;
    samples++;
    delay(5);
  }
  uint32_t pctHigh = samples ? highs * 100 / samples : 0;

  if (pctHigh >= 95)      { irActiveLevel = LOW;  irCalOk = true; }
  else if (pctHigh <= 5)  { irActiveLevel = HIGH; irCalOk = true; }
  else                    { irActiveLevel = IR_ACTIVE_LEVEL; irCalOk = false; }

  bootLine("", 112);
  if (irCalOk) bootLine(irActiveLevel == HIGH ? "Fabric sensor OK (HIGH)" : "Fabric sensor OK (LOW)", 100, TFT_GREEN);
  else         bootLine("FABRIC SENSOR FLICKERING", 100, TFT_RED);
  delay(800);
}

void processPulses() {
  noInterrupts();
  uint32_t n = isrPulses;
  isrPulses = 0;
  interrupts();
  if (n == 0) return;
  lastPulseMs = millis();

  bool changed = false;
  while (n--) {
    if (garmentPresent && qtyRemaining > 0 && styleNo.length() > 0) {
      pulseRemainder++;
      if (pulseRemainder < PULSES_PER_STITCH) continue;
      pulseRemainder = 0;
      if (pulseCount < 255) pulseCount++;
      changed = true;
      if (pulseCount == stitchN)
        Serial.printf("COMPLETE %d/%d - waiting for removal\n", pulseCount, stitchN);
    }
  }
  if (changed) requestRender();
}

