// Ring segment from fraction f0 to f1 (0 = 12 o'clock, clockwise).
// TFT_eSPI arcs use 0 deg = 6 o'clock, clockwise, range 0..360.
void drawRingSeg(int cx, int cy, int ro, int ri, float f0, float f1, uint16_t col) {
  if (f1 <= f0) return;
  int a0 = 180 + (int)(f0 * 360.0f + 0.5f);
  int a1 = 180 + (int)(f1 * 360.0f + 0.5f);
  if (a1 <= a0) return;
  if (a1 <= 360) {
    spr.drawArc(cx, cy, ro, ri, a0, a1, col, TFT_BLACK, true);
  } else if (a0 >= 360) {
    spr.drawArc(cx, cy, ro, ri, a0 - 360, a1 - 360, col, TFT_BLACK, true);
  } else {
    spr.drawArc(cx, cy, ro, ri, a0, 360, col, TFT_BLACK, true);
    spr.drawArc(cx, cy, ro, ri, 0, a1 - 360, col, TFT_BLACK, true);
  }
}

// Stitch ring gauge (left column)
void drawStitchRing(int cx, int cy, int ro, int ri) {
  int nSafe = max(stitchN, 1);
  spr.drawArc(cx, cy, ro, ri, 0, 360, COL_TRACK, TFT_BLACK, true);

  float f = (float)min(pulseCount, nSafe) / nSafe;
  uint16_t col = (pulseCount >= stitchMin) ? COL_GOOD : COL_RING;
  if (pulseCount >= nSafe) spr.drawArc(cx, cy, ro, ri, 0, 360, col, TFT_BLACK, true);
  else                     drawRingSeg(cx, cy, ro, ri, 0.0f, f, col);

  // MIN marker
  float fm = (float)stitchMin / nSafe;
  if (fm > 0.0f && fm < 1.0f) {
    float th = fm * TWO_PI;
    float s = sinf(th), c = cosf(th);
    spr.drawWideLine(cx + (ri - 3) * s, cy - (ri - 3) * c,
                     cx + (ro + 2) * s, cy - (ro + 2) * c,
                     2, TFT_WHITE, TFT_BLACK);
  }

  // count in the middle
  char buf[8];
  snprintf(buf, sizeof(buf), "%d", pulseCount);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_WHITE);
