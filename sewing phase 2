  spr.drawString(gtxt, px + pw / 2, 9, 1);

  String st = hasJob ? (styleNo + " " + operationCode) : String("-");
  int avail = px - 4 - styleX;
  while (st.length() > 1 && spr.textWidth(st, 1) > avail) st.remove(st.length() - 1);
