// =================================================
// RFID READER   (unchanged)
// =================================================
#define CommandReg     0x01
#define ComIrqReg      0x04
#define DivIrqReg      0x05
#define ErrorReg       0x06
#define FIFODataReg    0x09
#define FIFOLevelReg   0x0A
#define ControlReg     0x0C
#define BitFramingReg  0x0D
#define CollReg        0x0E
#define ModeReg        0x11
#define TxControlReg   0x14
#define TxASKReg       0x15
#define CRCResultRegH  0x21
#define CRCResultRegL  0x22
#define RFCfgReg       0x26
#define TModeReg       0x2A
#define TPrescalerReg  0x2B
#define TReloadRegH    0x2C
#define TReloadRegL    0x2D
#define VersionReg     0x37

#define RC_CMD_IDLE       0x00
#define RC_CMD_CALCCRC    0x03
#define RC_CMD_TRANSCEIVE 0x0C
#define RC_CMD_SOFTRESET  0x0F

enum RfStatus { RF_OK, RF_TIMEOUT, RF_ERROR, RF_NOROOM };

SPIClass    rfidSPI(HSPI);
SPISettings rfidSettings(RFID_SPI_FREQ, MSBFIRST, SPI_MODE0);

bool isKnownVersion(uint8_t v) {
  return v == 0xB2 || v == 0x82 || v == 0x91 || v == 0x92;
}

const char *chipName(uint8_t v) {
  switch (v) {
    case 0xB2: return "Si512";
    case 0x82: return "PN512";
    case 0x91: return "MFRC522 v1.0";
    case 0x92: return "MFRC522 v2.0";
    default:   return "Unknown";
  }
}

void writeReg(uint8_t reg, uint8_t val) {
  rfidSPI.beginTransaction(rfidSettings);
  digitalWrite(PIN_RFID_SS, LOW);
  delayMicroseconds(2);
  rfidSPI.transfer((reg << 1) & 0x7E);
  rfidSPI.transfer(val);
  delayMicroseconds(2);
  digitalWrite(PIN_RFID_SS, HIGH);
  rfidSPI.endTransaction();
}

uint8_t readReg(uint8_t reg) {
  rfidSPI.beginTransaction(rfidSettings);
  digitalWrite(PIN_RFID_SS, LOW);
  delayMicroseconds(2);
  rfidSPI.transfer(0x80 | ((reg << 1) & 0x7E));
  uint8_t val = rfidSPI.transfer(0x00);
  delayMicroseconds(2);
  digitalWrite(PIN_RFID_SS, HIGH);
  rfidSPI.endTransaction();
  return val;
}

void setBits(uint8_t reg, uint8_t mask)   { writeReg(reg, readReg(reg) | mask); }
void clearBits(uint8_t reg, uint8_t mask) { writeReg(reg, readReg(reg) & ~mask); }

void resetReader() {
  if (PIN_RFID_RST >= 0) {
    digitalWrite(PIN_RFID_RST, LOW);
    delay(10);
    digitalWrite(PIN_RFID_RST, HIGH);
    delay(50);
  }
  writeReg(CommandReg, RC_CMD_SOFTRESET);
  delay(50);
}

bool calcCRC(const uint8_t *data, uint8_t len, uint8_t *out) {
  writeReg(CommandReg, RC_CMD_IDLE);
  writeReg(DivIrqReg, 0x04);
  writeReg(FIFOLevelReg, 0x80);
  for (uint8_t i = 0; i < len; i++) writeReg(FIFODataReg, data[i]);
  writeReg(CommandReg, RC_CMD_CALCCRC);
  uint32_t t = millis();
  while (millis() - t < 50) {
    if (readReg(DivIrqReg) & 0x04) {
      writeReg(CommandReg, RC_CMD_IDLE);
      out[0] = readReg(CRCResultRegL);
      out[1] = readReg(CRCResultRegH);
      return true;
    }
  }
  return false;
}

RfStatus transceive(const uint8_t *send, uint8_t sendLen,
                    uint8_t *back, uint8_t *backLen, uint8_t txLastBits = 0) {
  writeReg(CommandReg, RC_CMD_IDLE);
  writeReg(ComIrqReg, 0x7F);
  writeReg(FIFOLevelReg, 0x80);
  for (uint8_t i = 0; i < sendLen; i++) writeReg(FIFODataReg, send[i]);
  writeReg(BitFramingReg, txLastBits);
  writeReg(CommandReg, RC_CMD_TRANSCEIVE);
  setBits(BitFramingReg, 0x80);

  bool done = false;
  uint32_t t = millis();
  while (millis() - t < 50) {
    uint8_t irq = readReg(ComIrqReg);
    if (irq & 0x30) { done = true; break; }
    if (irq & 0x01) break;
  }
  clearBits(BitFramingReg, 0x80);
  if (!done) return RF_TIMEOUT;
  if (readReg(ErrorReg) & 0x1B) return RF_ERROR;

  uint8_t n = readReg(FIFOLevelReg);
  if (n > *backLen) return RF_NOROOM;
  *backLen = n;
  for (uint8_t i = 0; i < n; i++) back[i] = readReg(FIFODataReg);
  return RF_OK;
}

void initReader() {
  writeReg(TModeReg, 0x80);
  writeReg(TPrescalerReg, 0xA9);
  writeReg(TReloadRegH, 0x03);
  writeReg(TReloadRegL, 0xE8);
  writeReg(TxASKReg, 0x40);
  writeReg(ModeReg, 0x3D);
  writeReg(ControlReg, 0x10);
  writeReg(RFCfgReg, 0x70);
  setBits(TxControlReg, 0x03);
}

void explainVersion(uint8_t v) {
  if (v == 0x00)      Serial.println("    -> 0x00: MISO held LOW. Check reader power / MISO wire.");
  else if (v == 0xFF) Serial.println("    -> 0xFF: MISO floating. Check SPI switch, SS wire.");
  else                Serial.println("    -> Other value: SCK/MOSI swapped or noisy wires.");
}

bool connectReader(int attempts, bool verbose) {
  for (int i = 1; i <= attempts; i++) {
    resetReader();
    uint8_t v = readReg(VersionReg);
    if (isKnownVersion(v)) {
      initReader();
      if (verbose) Serial.printf("RFID reader found. VersionReg = 0x%02X (%s)\n", v, chipName(v));
      return true;
    }
    if (verbose) {
      Serial.printf("  RFID attempt %d: VersionReg = 0x%02X\n", i, v);
      if (i == 1) explainVersion(v);
    }
    if (i < attempts) delay(200);
  }
  return false;
}

bool readCardUID(uint8_t *uid, uint8_t &uidLen, uint8_t &sak) {
  uint8_t buf[5];
  uint8_t len = 2;
  uint8_t reqa = 0x26;

  clearBits(CollReg, 0x80);
  if (transceive(&reqa, 1, buf, &len, 0x07) != RF_OK || len != 2) return false;

  const uint8_t selCodes[3] = {0x93, 0x95, 0x97};
  uidLen = 0;

  for (uint8_t level = 0; level < 3; level++) {
    uint8_t anti[2] = {selCodes[level], 0x20};
    len = 5;
    if (transceive(anti, 2, buf, &len) != RF_OK || len != 5) return false;
    if ((buf[0] ^ buf[1] ^ buf[2] ^ buf[3]) != buf[4]) return false;

    uint8_t sel[9] = {selCodes[level], 0x70, buf[0], buf[1], buf[2], buf[3], buf[4]};
    if (!calcCRC(sel, 7, &sel[7])) return false;
    uint8_t sakBuf[3];
    len = 3;
    if (transceive(sel, 9, sakBuf, &len) != RF_OK || len != 3) return false;
    sak = sakBuf[0];

    if (buf[0] == 0x88) {
      memcpy(&uid[uidLen], &buf[1], 3);
      uidLen += 3;
    } else {
      memcpy(&uid[uidLen], buf, 4);
      uidLen += 4;
    }
    if (!(sak & 0x04)) return true;
  }
  return false;
}

void haltCard() {
  uint8_t hlt[4] = {0x50, 0x00};
  calcCRC(hlt, 2, &hlt[2]);
  uint8_t dummy[2];
  uint8_t len = sizeof(dummy);
  transceive(hlt, 4, dummy, &len);
}

String uidToString(const uint8_t *uid, uint8_t len) {
  String s = "";
  char b[4];
  for (uint8_t i = 0; i < len; i++) {
    snprintf(b, sizeof(b), "%02X", uid[i]);
    s += b;
    if (i < len - 1) s += ":";
  }
  return s;
}

void pollRfid() {
  static unsigned long lastPoll = 0, lastHealth = 0, lastRetry = 0;
  unsigned long now = millis();

  if (!rfidOk) {
    if (now - lastRetry >= RFID_RETRY_MS) {
      lastRetry = now;
      rfidOk = connectReader(1, false);
      if (rfidOk) { Serial.println("RFID reader connected."); requestRender(); }
    }
    return;
  }

  if (now - lastHealth >= 2000) {
    lastHealth = now;
    if (!isKnownVersion(readReg(VersionReg))) {
      rfidOk = false;
      lastRetry = now;
      Serial.println("RFID reader lost - will retry.");
      requestRender();
      return;
    }
  }

  if (now - lastPoll < RFID_POLL_MS) return;
  lastPoll = now;

  uint8_t uid[10];
  uint8_t uidLen = 0, sak = 0;
  if (readCardUID(uid, uidLen, sak)) {
    String s = uidToString(uid, uidLen);
    haltCard();
    if (s != lastUid) {
      lastUid = s;
      newCardUntil = millis() + NEWCARD_MS;
      Serial.printf("CARD UID: %s  (%d bytes)  SAK=0x%02X\n", s.c_str(), uidLen, sak);
      requestRender();
    }
  }
}

