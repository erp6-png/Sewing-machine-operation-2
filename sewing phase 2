  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(COL_AMBER);
  spr.drawString(st, styleX, 10, 1);

  // ---------- CARD ROW: CARD uid ...... [queue dot] WIFI ----------
  bool newCard = (millis() < newCardUntil);
  int rightUsed = 0;
#if USE_WIFI
  drawWiFiBars(SCR_W - 19, 28);
  rightUsed = 20;
#endif
  if (qCount > 0) { spr.fillCircle(SCR_W - rightUsed - 5, 24, 3, TFT_ORANGE); rightUsed += 10; }
  if (newCard) spr.fillRect(0, 18, SCR_W - rightUsed - 1, 13, TFT_DARKGREEN);
  if (!rfidOk) {
    drawFit("RFID NOT FOUND", 3, 24, SCR_W - 6 - rightUsed, TFT_RED);
