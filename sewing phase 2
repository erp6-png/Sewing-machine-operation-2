  } else {
    spr.setTextDatum(ML_DATUM);
    spr.setTextColor(newCard ? TFT_WHITE : COL_LABEL);
    spr.drawString("CARD", 3, 25, 1);
    drawFit(lastUid, 30, 24, SCR_W - 33 - rightUsed, newCard ? TFT_WHITE : COL_AMBER);
  }
  spr.drawFastHLine(0, 31, SCR_W, COL_SEP);

  // ---------- LEFT: STITCH RING ----------
  const int cx = 30, cy = 70;
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(COL_LABEL);
  spr.drawString("STITCHES", cx, 38, 1);
  drawStitchRing(cx, cy, 25, 19);

  snprintf(buf, sizeof(buf), "MIN %d/%d", stitchMin, stitchN);
  if (spr.textWidth(buf, 1) > 58) snprintf(buf, sizeof(buf), "%d/%d", stitchMin, stitchN);
  spr.setTextColor(COL_AMBER);
  spr.drawString(buf, cx, 103, 1);

  // ---------- RIGHT: FINISHED (FG) CARD ----------
  const int fx = 60, fy = 35, fw = SCR_W - 3 - fx, fh = 48;
  uint16_t border = flashing ? flashColor : COL_ACCENT;
  spr.fillRoundRect(fx, fy, fw, fh, 6, COL_FG_BG);
  spr.drawRoundRect(fx, fy, fw, fh, 6, border);
  spr.drawRoundRect(fx + 1, fy + 1, fw - 2, fh - 2, 5, border);
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(COL_ACCENT);
  spr.drawString("FINISHED (FG)", fx + 6, fy + 8, 1);

  snprintf(buf, sizeof(buf), "%ld", finishedFG);
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(TFT_WHITE);
  spr.setFreeFont(&FreeSansBold18pt7b);
  if (spr.textWidth(buf) > fw - 8) spr.setFreeFont(&FreeSansBold12pt7b);
  spr.drawString(buf, fx + fw / 2, fy + fh - 5);
  spr.setTextFont(1);

  // ---------- RIGHT: QTY / DISC / N ----------
  const int by = 86, bh = 24, gap = 2;
  int bw = (fw - 2 * gap) / 3;
  drawBox(fx,                by, bw, bh, "QTY",  hasJob ? qtyRemaining : 0,
          COL_ACCENT, COL_ACCENT, flashing && flashColor == TFT_GREEN);
  drawBox(fx + bw + gap,     by, bw, bh, "DISC", discardedCnt,
          COL_DISC, COL_DISC, flashing && flashColor == TFT_RED);
  drawBox(fx + 2 * (bw + gap), by, fx + fw - (fx + 2 * (bw + gap)), bh, "N", stitchN,
          COL_AMBER, COL_AMBER, false);

  // ---------- STATUS BAR ----------
  if (flashing) {
    drawStatus(flashColor, TFT_BLACK, flashText.c_str());
  } else if (!hasJob) {
    drawStatus(COL_PANEL, COL_LABEL, "WAITING FOR JOB");
  } else if (qtyRemaining <= 0 && pulseCount == 0) {
    drawStatus(COL_GOOD, TFT_BLACK, "JOB DONE");
  } else if (garmentPresent && pulseCount >= stitchN) {
    drawStatus(COL_GOOD, TFT_BLACK, "COMPLETE - REMOVE");
  } else if (garmentPresent && pulseCount >= stitchMin) {
    drawStatus(COL_PANEL, COL_GOOD, "MIN OK - CAN REMOVE");
  } else if (garmentPresent) {
    drawStatus(COL_PANEL, TFT_WHITE, "KEEP SEWING");
  } else {
    drawStatus(COL_PANEL, COL_AMBER, "PLACE GARMENT");
  }

  spr.pushSprite(0, 0);
}

