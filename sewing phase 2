  if (otaInProgress) return;
  spr.fillSprite(TFT_BLACK);
  char buf[32];
  bool flashing = (flashText.length() > 0 && millis() < flashUntil);
  bool hasJob = (styleNo.length() > 0);

  // ---------- HEADER: MC  M01  STYLE ...........  [FABRIC] ----------
