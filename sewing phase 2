// Minimal JSON helpers -- same approach as the old firmware (no library),
// just string-key lookups. Good enough for the small, flat replies this
// API always returns.
String jsonStr(const String &js, const char* key) {
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return "";
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  if (p >= (int)js.length() || js[p] != '"') return "";
  int e = js.indexOf('"', p + 1);
  if (e < 0) return "";
  return js.substring(p + 1, e);
}

bool jsonInt(const String &js, const char* key, long &out) {
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return false;
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  out = js.substring(p).toInt();
  return true;
}

bool jsonBool(const String &js, const char* key, bool &out) {
  String k = String("\"") + key + "\":";
  int p = js.indexOf(k);
  if (p < 0) return false;
  p += k.length();
  while (p < (int)js.length() && js[p] == ' ') p++;
  out = js.startsWith("true", p);
  return true;
}

// One client, reused for every call -- setInsecure() skips certificate
// validation (no root CA bundle needed). Fine for this R&D build; swap in
// a proper CA if this ever becomes a permanent deployment.
WiFiClientSecure secureClient;

bool httpPostJson(const String &path, const String &deviceKeyHeader, const String &body, String &response) {
  HTTPClient http;
  http.setConnectTimeout(5000);
  http.setTimeout(5000);
  if (!http.begin(secureClient, String(SERVER_URL) + path)) return false;
  http.addHeader("Content-Type", "application/json");
  if (deviceKeyHeader.length()) http.addHeader("X-Device-Key", deviceKeyHeader);
  int code = http.POST(body);
  response = http.getString();
  http.end();
  return code >= 200 && code < 300;
}

bool httpGet(const String &path, const String &deviceKeyHeader, String &response) {
  HTTPClient http;
  http.setConnectTimeout(5000);
  http.setTimeout(5000);
  if (!http.begin(secureClient, String(SERVER_URL) + path)) return false;
  if (deviceKeyHeader.length()) http.addHeader("X-Device-Key", deviceKeyHeader);
  int code = http.GET();
  response = http.getString();
  http.end();
  return code == 200;
}

// Saves whatever we've learned so far to flash, so a reboot (power cycle,
// crash, OTA) never has to re-approve the board -- only a re-flash that
// erases this namespace, or an admin deactivating it, resets this.
void saveIdentity() {
  idPrefs.begin("iot_id", false);
  idPrefs.putString("device_key", deviceKey);
  idPrefs.putString("device_id", deviceId);
  idPrefs.putString("machine_label", machineLabel);
  idPrefs.end();
}

void loadIdentity() {
  idPrefs.begin("iot_id", true);
  deviceKey    = idPrefs.getString("device_key", "");
  deviceId     = idPrefs.getString("device_id", "");
  machineLabel = idPrefs.getString("machine_label", "");
  idPrefs.end();
}

// POST /api/v1/device/hello -- no key needed. Self-registers an unknown
// hw_id as "pending" server-side. Once approved, the key comes back
// exactly once; we grab it the moment it appears and save it to flash.
void doHello() {
  String body = String("{\"hw_id\":\"") + hwId + "\",\"firmware_version\":\"" FW_VERSION "\"}";
  String resp;
  if (!httpPostJson(PATH_HELLO, "", body, resp)) {
    Serial.println("hello: request failed (network/server)");
    return;
  }
  String status = jsonStr(resp, "status");
  Serial.printf("hello: status=%s\n", status.c_str());

  if (status == "pending" || status == "inactive") {
    jobState = "no_open_run"; // display falls back to "WAITING FOR APPROVAL" via deviceKey.length()==0 check
    return;
  }

  String key = jsonStr(resp, "device_key");
  if (key.length()) {
    // One-time reveal -- this is the only moment we'll ever see this key.
    deviceKey    = key;
    deviceId     = jsonStr(resp, "device_id");
    machineLabel = jsonStr(resp, "machine_label");
    saveIdentity();
    flash("APPROVED: " + machineLabel, TFT_GREEN, 4000);
    Serial.printf("hello: approved as %s (%s), key saved\n", machineLabel.c_str(), deviceId.c_str());
  } else if (deviceKey.length() == 0) {
    // Approved already (status unmapped/mapped) but we don't have a key
    // saved locally -- e.g. this is a fresh flash onto a board whose hw_id
    // was approved before. The key was already handed out once before, so
    // it will NOT be repeated here; an admin needs to re-approve (or, if
    // you added one, use a server-side "reissue key" action) to get a new
    // one. Keep polling in case that happens.
    machineLabel = jsonStr(resp, "machine_label");
    Serial.println("hello: already approved elsewhere, but no key on file -- needs re-approval to get a new one");
  }
}

// GET /api/v1/iot/device/job -- resolves this device's current job purely
// from its key. Called on every JOB_POLL_MS tick once provisioned.
void fetchJob() {
  String resp;
  if (!httpGet(PATH_JOB, deviceKey, resp)) {
    Serial.println("job: request failed (network/server)");
    return;
  }
  String state = jsonStr(resp, "state");
  if (state.length() == 0) return;

  String newStyle = jsonStr(resp, "style_id");
  String newOp     = jsonStr(resp, "operation_code");
  String jobKey    = newStyle + "|" + newOp;

  if (state != jobState) requestRender();
  jobState = state;

  if (state == "ready") {
    long target = 0;
    jsonInt(resp, "stitch_target", target);
    bool fallback = false;
    jsonBool(resp, "size_was_fallback", fallback);

    // A genuinely new job (style or operation changed) resets the local
    // FG/DISC counters and the in-progress pulse count -- same reasoning
    // as the old firmware's style-change reset, just keyed off style+
    // operation together now instead of style alone.
    if (jobKey != lastJobKey) {
      lastJobKey   = jobKey;
      finishedFG   = 0;
      discardedCnt = 0;
      pulseCount   = 0;
      pulseRemainder = 0;
      requestRender();
    }

    styleNo         = newStyle;
    operationCode   = newOp;
    sizeUsed        = jsonStr(resp, "size_used");
    sizeWasFallback = fallback;
    stitchN         = (int)target;
    stitchMin       = (int)target; // no separate minimum from the server yet -- see header note
  } else {
    // Not ready (no_open_run / waiting_to_be_mapped / no_operations_master_row /
    // inactive) -- keep whatever style/op text was last known for context,
    // but stop counting new stitches (processPulses() checks jobState).
    lastJobKey = "";
  }
}

// POST /api/v1/iot/events -- one finished/discarded garment at a time,
// oldest first. mapping_id is resolved server-side from this device's
// current mapping, never sent from here.
void sendOneEvent() {
  Event &e = queueBuf[qHead];
  char id[48];
  snprintf(id, sizeof(id), "%s-%08lX-%lu", deviceId.c_str(), (unsigned long)bootId, (unsigned long)e.seq);

  time_t nowT = time(nullptr);
  struct tm tmInfo;
  gmtime_r(&nowT, &tmInfo);
  char iso[24];
  strftime(iso, sizeof(iso), "%Y-%m-%dT%H:%M:%S", &tmInfo);

  String body = String("{\"events\":[{\"client_event_id\":\"") + id +
                "\",\"stitch_count\":" + String(e.stitchCount) +
                ",\"event_time\":\"" + iso + "\"}]}";

  String resp;
  bool ok = httpPostJson(PATH_EVENTS, deviceKey, body, resp);
  if (ok) {
    qHead = (qHead + 1) % QUEUE_SIZE;
    qCount--;
    requestRender();
  } else {
    Serial.println("events: post failed, will retry");
  }
}

void syncWithServer() {
  if (WiFi.status() != WL_CONNECTED) return;

  if (deviceKey.length() == 0) {
    // Not provisioned yet (or key was never saved) -- keep knocking.
    doHello();
    return;
  }
  if (qCount > 0) sendOneEvent();
  else            fetchJob();
}
#endif // USE_SERVER

// =================================================
// SETUP
// =================================================
void setup() {
  Serial.begin(115200);
  pinMode(irPin, INPUT_PULLUP);
  pinMode(pulsePin, INPUT);              // GPIO34: external 10k pull-up to 3.3V required
  lastHighUs = micros();
  attachInterrupt(digitalPinToInterrupt(pulsePin), onPulse, CHANGE);

  pinMode(PIN_RFID_SS, OUTPUT);
  digitalWrite(PIN_RFID_SS, HIGH);
  if (PIN_RFID_RST >= 0) {
    pinMode(PIN_RFID_RST, OUTPUT);
    digitalWrite(PIN_RFID_RST, HIGH);
  }

  resetText = resetReasonText(esp_reset_reason(), resetBad);
  prefs.begin("diag", false);
  bootCount = prefs.getUInt("boots", 0) + 1;
  prefs.putUInt("boots", bootCount);
  if (resetBad) prefs.putUInt("bad", prefs.getUInt("bad", 0) + 1);
  uint32_t badCount = prefs.getUInt("bad", 0);
  prefs.end();

  delay(500);
  initDisplay();
  delay(100);
  initDisplay();
  if (!spr.createSprite(SCR_W, SCR_H)) Serial.println("ERROR: not enough RAM for sprite");

  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString("SEWING COUNTER", SCR_W / 2, 30, 2);
  tft.setTextColor(TFT_SILVER, TFT_BLACK);
  tft.drawString("FW " FW_VERSION, SCR_W / 2, 50, 1);
  char bl[40];
  snprintf(bl, sizeof(bl), "BOOT #%lu  %s", (unsigned long)bootCount, resetText);
  bootLine(bl, 64, resetBad ? TFT_RED : TFT_SILVER);

  Serial.println();
  Serial.printf("=== Sewing Counter FW %s (IoT clone) ===\n", FW_VERSION);
  Serial.printf("BOOT #%lu  last restart: %s  bad restarts: %lu  free RAM: %u\n",
                (unsigned long)bootCount, resetText, (unsigned long)badCount,
                (unsigned)ESP.getFreeHeap());
  Serial.printf("Stitch: re-arm %lu us, lockout %lu us, %d pulse(s)/stitch\n",
                (unsigned long)STITCH_REARM_US, (unsigned long)STITCH_LOCKOUT_US, PULSES_PER_STITCH);

  bootLine("Starting RFID...", 80);
  delay(100);
  rfidSPI.begin(PIN_RFID_SCK, PIN_RFID_MISO, PIN_RFID_MOSI, -1);
  rfidOk = connectReader(3, true);
  if (!rfidOk) Serial.println("RFID reader not found - will retry every 5 s.");
  bootLine(rfidOk ? "RFID OK" : "RFID NOT FOUND", 80, rfidOk ? TFT_GREEN : TFT_ORANGE);

  calibrateIr();

  bootId = esp_random();

  // hw_id = this board's own WiFi MAC, e.g. "AA:BB:CC:DD:EE:FF" -- the
  // ONE fixed identity the server needs. Available as soon as WiFi mode is
  // set, before a connection even succeeds.
  WiFi.mode(WIFI_STA);
  hwId = WiFi.macAddress();
  Serial.printf("hw_id: %s\n", hwId.c_str());

#if USE_WIFI
  bootLine("Connecting Wi-Fi...", 112);
  connectWiFi(8000);
  softRefreshDisplay();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("WiFi OK: %s  IP %s  RSSI %d dBm\n", WIFI_SSID,
                  WiFi.localIP().toString().c_str(), (int)WiFi.RSSI());
  } else {
    Serial.printf("WiFi NOT connected to \"%s\".\n", WIFI_SSID);
  }
#else
  connectWiFi(0);
  Serial.println("WiFi DISABLED");
#endif

#if USE_SERVER
  secureClient.setInsecure();
  // event_time needs a real clock -- NTP over whatever WiFi we have.
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  loadIdentity();
  if (deviceKey.length()) {
    Serial.printf("Loaded saved identity: device_id=%s machine_label=%s\n", deviceId.c_str(), machineLabel.c_str());
  } else {
    Serial.println("No saved key yet -- will self-register as pending and wait for approval.");
  }
#endif

  irCandidate = (digitalRead(irPin) == irActiveLevel);
  irCandidateSince = millis();
  garmentPresent = irCandidate;

  if (resetBad) flash(String("LAST RESTART: ") + resetText, TFT_RED, 8000);
  render();
}

// =================================================
// LOOP
// =================================================
void loop() {
  manageOTA();
  if (otaInProgress) return;

  readGarmentSensor();
  processPulses();
  pollRfid();
  keepWiFiAlive();

#if USE_SERVER
  static unsigned long lastSync = 0;
  unsigned long syncIntervalMs = (deviceKey.length() == 0) ? HELLO_RETRY_MS : JOB_POLL_MS;
  bool safeToSync = !garmentPresent || (millis() - lastPulseMs > 1500);
  if (safeToSync && millis() - lastSync >= syncIntervalMs) {
    lastSync = millis();
    syncWithServer();
  }
#endif

  static unsigned long lastSoft = 0;
  static bool lastWifiUp = false;
  bool wifiUp = (WiFi.status() == WL_CONNECTED);
  if ((DISPLAY_SOFT_REFRESH_MS > 0 && millis() - lastSoft >= DISPLAY_SOFT_REFRESH_MS) ||
      (wifiUp && !lastWifiUp)) {
    lastSoft = millis();
    softRefreshDisplay();
    requestRender();
  }
  lastWifiUp = wifiUp;

  static unsigned long lastRender = 0;
  unsigned long now = millis();
  if ((renderDirty && now - lastRender >= RENDER_MIN_MS) || now - lastRender >= RENDER_MAX_MS) {
    lastRender = now;
    renderDirty = false;
    render();
  }

  static unsigned long lastDebug = 0;
  if (millis() - lastDebug >= 2000) {
    lastDebug = millis();
    static uint32_t lastChanges = 0;
    uint32_t flips = irRawChanges - lastChanges;
    lastChanges = irRawChanges;

    noInterrupts();
    uint32_t rej = isrRejected;
    uint32_t minGap = isrMinGapUs;
    isrRejected = 0;
    isrMinGapUs = 0xFFFFFFFF;
    interrupts();

    String ipTxt = wifiUp ? WiFi.localIP().toString() : String("OFFLINE");
    String gapTxt = (minGap == 0xFFFFFFFF) ? String("-") : String(minGap / 1000) + "ms";
    Serial.printf("IR=%d(fab=%s)%s GARMENT=%s | PULSE=%d ST %d (min %d/max %d) REJ=%lu GAPmin=%s | JOB=%s FG=%ld DISC=%ld | RFID=%s UID=%s | WIFI=%s RAMmin=%u\n",
                  digitalRead(irPin), irActiveLevel == HIGH ? "H" : "L",
                  flips > 10 ? " FLICKER" : "",
                  garmentPresent ? "PRESENT" : "ABSENT",
                  digitalRead(pulsePin), pulseCount, stitchMin, stitchN,
                  (unsigned long)rej, gapTxt.c_str(),
                  jobState.c_str(), finishedFG, discardedCnt,
                  rfidOk ? "OK" : "MISSING", lastUid.length() ? lastUid.c_str() : "-",
                  ipTxt.c_str(), (unsigned)ESP.getMinFreeHeap());
  }
}
