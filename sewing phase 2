int wifiBars() {
  if (WiFi.status() != WL_CONNECTED) return -1;
  long rssi = WiFi.RSSI();
  if (rssi > -55) return 4;
  if (rssi > -65) return 3;
  if (rssi > -75) return 2;
  if (rssi > -85) return 1;
  return 0;
}

// 4 bars, 15 px wide, bottom at yb
void drawWiFiBars(int x, int yb) {
  int bars = wifiBars();
  for (int i = 0; i < 4; i++) {
    int h = 3 + i * 3;
    uint16_t col = (bars > i) ? COL_GOOD : COL_WIFI_OFF;
    spr.fillRect(x + i * 4, yb - h + 1, 3, h, col);
  }
  if (bars < 0) {
    spr.drawLine(x, yb - 11, x + 14, yb, TFT_RED);
    spr.drawLine(x, yb, x + 14, yb - 11, TFT_RED);
  }
}

