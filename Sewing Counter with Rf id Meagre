// =================================================
void setup() {
  Serial.begin(115200);
  pinMode(irPin, INPUT);
  pinMode(pulsePin, INPUT);            // GPIO34: external 10k pull-up to 3.3V
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW);
  attachInterrupt(digitalPinToInterrupt(pulsePin), onPulse, FALLING);

  // RFID chip-select idle HIGH before anything else talks on the bus
  pinMode(PIN_RFID_SS, OUTPUT);
  digitalWrite(PIN_RFID_SS, HIGH);
  if (PIN_RFID_RST >= 0) {
    pinMode(PIN_RFID_RST, OUTPUT);
    digitalWrite(PIN_RFID_RST, HIGH);
  }

  tft.init();
  tft.setRotation(SCREEN_ROTATION);
  tft.fillScreen(TFT_BLACK);
  spr.createSprite(SCR_W, SCR_H);

  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString("SEWING COUNTER", SCR_W / 2, 40, 2);
  tft.drawString("FW " FW_VERSION, SCR_W / 2, 65, 1);
  tft.drawString("Starting RFID...", SCR_W / 2, 85, 1);

  Serial.println();
  Serial.printf("=== Sewing Counter + RFID FW %s  ID %s ===\n", FW_VERSION, MACHINE_ID);

  // RFID reader on its own HSPI bus (SS driven by hand, so pass -1 here)
  delay(100);                          // let the reader power up
  rfidSPI.begin(PIN_RFID_SCK, PIN_RFID_MISO, PIN_RFID_MOSI, -1);
  rfidOk = connectReader(3, true);
  if (!rfidOk) Serial.println("RFID reader not found - counter keeps running, will retry every 5 s.");

  tft.drawString("Connecting Wi-Fi...", SCR_W / 2, 100, 1);
  bootId = esp_random();
  connectWiFi(8000);

  Serial.printf("Mode: %s\n", USE_SERVER ? "SERVER" : "STANDALONE (no server)");
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("WiFi OK: %s  IP %s  RSSI %d dBm\n", WIFI_SSID,
                  WiFi.localIP().toString().c_str(), (int)WiFi.RSSI());
  } else {
    Serial.printf("WiFi NOT connected to \"%s\" - check name/password (2.4 GHz only). Will keep retrying.\n", WIFI_SSID);
  }

#if !USE_SERVER
  styleNo      = LOCAL_STYLE;          // standalone job
  qtyRemaining = LOCAL_QTY;
  stitchN      = LOCAL_N;
  stitchMin    = min(LOCAL_N_MIN, LOCAL_N);
#endif

  irCandidate = (digitalRead(irPin) == IR_ACTIVE_LEVEL);
  garmentPresent = irCandidate;
  render();
}

void loop() {
  manageOTA();
  if (otaInProgress) return;           // do nothing else while updating

  readGarmentSensor();
  processPulses();
  pollRfid();
  keepWiFiAlive();

#if USE_SERVER
  // Use the network only when the machine is idle (a slow request must never
  // delay garment detection in the middle of stitching)
  static unsigned long lastSync = 0;
  bool safeToSync = !garmentPresent || (millis() - lastPulseSeenMs > IDLE_BEFORE_SYNC_MS);
  if (safeToSync && millis() - lastSync >= SYNC_INTERVAL_MS) {
    lastSync = millis();
    syncWithServer();
  }
#endif

  static unsigned long lastRender = 0;
  if (millis() - lastRender >= RENDER_INTERVAL_MS) {
    lastRender = millis();
    render();
  }

  // Serial status every 2 s (open Serial Monitor at 115200)
  static unsigned long lastDebug = 0;
  if (millis() - lastDebug >= 2000) {
    lastDebug = millis();
    Serial.printf("IR=%d GARMENT=%s PULSE_PIN=%d  %d (min %d / max %d)  Q=%ld FG=%ld DISC=%ld  RFID=%s UID=%s  WIFI=%s\n",
                  digitalRead(irPin), garmentPresent ? "PRESENT" : "ABSENT",
                  digitalRead(pulsePin), pulseCount, stitchMin, stitchN,
                  qtyRemaining, finishedFG, discardedCnt,
                  rfidOk ? "OK" : "MISSING", lastUid.length() ? lastUid.c_str() : "-",
                  WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "OFFLINE");
  }
}
