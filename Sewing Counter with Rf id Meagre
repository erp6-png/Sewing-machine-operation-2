// Called from loop(): finds cards, keeps the reader healthy, never blocks for long
void pollRfid() {
  static unsigned long lastPoll = 0, lastHealth = 0, lastRetry = 0;
  unsigned long now = millis();

  if (!rfidOk) {                                   // reader missing: retry now and then
    if (now - lastRetry >= RFID_RETRY_MS) {
      lastRetry = now;
      rfidOk = connectReader(1, false);
      if (rfidOk) { Serial.println("RFID reader connected."); render(); }
    }
    return;
  }

  if (now - lastHealth >= 2000) {                  // health check every 2 s
    lastHealth = now;
    if (!isKnownVersion(readReg(VersionReg))) {
      rfidOk = false;
      lastRetry = now;
      Serial.println("RFID reader lost - will retry.");
      render();
      return;
    }
  }

  if (now - lastPoll < RFID_POLL_MS) return;
  lastPoll = now;

  uint8_t uid[10];
  uint8_t uidLen = 0, sak = 0;
  if (readCardUID(uid, uidLen, sak)) {
    String s = uidToString(uid, uidLen);
    haltCard();
    if (s != lastUid) {                            // new / different card
      lastUid = s;
      newCardUntil = millis() + NEWCARD_MS;
      Serial.printf("CARD UID: %s  (%d bytes)  SAK=0x%02X\n", s.c_str(), uidLen, sak);
      beep(1);
      render();
    }
    // same card tapped again: nothing changes
  }
}

// =================================================
// DRAWING
// =================================================
int wifiBars() {
  if (WiFi.status() != WL_CONNECTED) return -1;
  long rssi = WiFi.RSSI();
  if (rssi > -55) return 4;
  if (rssi > -65) return 3;
  if (rssi > -75) return 2;
  if (rssi > -85) return 1;
  return 0;
}

void drawWiFiBars(int x, int yb) {
  int bars = wifiBars();
  for (int i = 0; i < 4; i++) {
    int h = 3 + i * 3;
    uint16_t col = (bars > i) ? TFT_GREEN : TFT_DARKGREY;
    spr.fillRect(x + i * 4, yb - h + 1, 3, h, col);
  }
  if (bars < 0) {
    spr.drawLine(x, yb - 11, x + 14, yb, TFT_RED);
    spr.drawLine(x, yb, x + 14, yb - 11, TFT_RED);
  }
}

// Draw left-aligned text in the bigger font if it fits, else the small font
void drawFit(const String &s, int x, int y, int maxW, uint16_t col) {
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(col);
  int f = (spr.textWidth(s, 2) <= maxW) ? 2 : 1;
  spr.drawString(s, x, y, f);
}

void drawBox(int x, int y, int w, int h, const char* label,
             long value, uint16_t col, bool active) {
  spr.fillRoundRect(x, y, w, h, 4, active ? col : 0x18E3);
  spr.drawRoundRect(x, y, w, h, 4, col);
  spr.fillRect(x + 2, y + 2, w - 4, 10, active ? TFT_WHITE : col);

  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_BLACK);
  spr.drawString(label, x + w / 2, y + 7, 1);

  char buf[12];
  snprintf(buf, sizeof(buf), "%ld", value);
  int cy = y + h - 4;
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(active ? TFT_BLACK : col);
  spr.setFreeFont(&FreeSansBold12pt7b);
  if (spr.textWidth(buf) <= w - 6) {
    spr.drawString(buf, x + w / 2, cy);
  } else {
    spr.setTextFont(2);
    spr.drawString(buf, x + w / 2, cy);
  }
  spr.setTextFont(1);
}

void render() {
  if (otaInProgress) return;                 // OTA screen owns the display
  spr.fillSprite(TFT_BLACK);
  char buf[24];
  bool flashing = (flashText.length() > 0 && millis() < flashUntil);
  bool hasJob = (styleNo.length() > 0);

  // ===== HEADER =====
  spr.fillRect(0, 0, SCR_W, 18, TFT_NAVY);
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(TFT_SILVER);
  spr.drawString("MC", 3, 9, 1);
  spr.setTextColor(TFT_WHITE);
  spr.drawString(MACHINE_ID, 20, 9, 2);

  const char* gtxt = garmentPresent ? "FABRIC" : "NO FABRIC";
  int pw = spr.textWidth(gtxt, 1) + 10;
  int px = SCR_W - pw - 3;
  spr.fillRoundRect(px, 3, pw, 12, 6, garmentPresent ? TFT_GREEN : TFT_YELLOW);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_BLACK);
  spr.drawString(gtxt, px + pw / 2, 9, 1);
  drawWiFiBars(px - 20, 15);

  // ===== RFID CARD ROW =====
  bool newCard = (millis() < newCardUntil);
  if (newCard) spr.fillRoundRect(1, 19, SCR_W - 2, 13, 3, TFT_DARKGREEN);
  if (!rfidOk) {
    drawFit("RFID NOT FOUND", 3, 26, SCR_W - 6, TFT_RED);
  } else if (lastUid.length() == 0) {
    drawFit("WAITING FOR RFID", 3, 26, SCR_W - 6, TFT_YELLOW);
  } else {
    spr.setTextDatum(ML_DATUM);
    spr.setTextColor(newCard ? TFT_WHITE : TFT_SILVER);
    spr.drawString("CARD", 3, 26, 1);
    drawFit(lastUid, 30, 26, SCR_W - 33, newCard ? TFT_WHITE : TFT_ORANGE);
  }
  if (qCount > 0) spr.fillCircle(SCR_W - 6, 25, 3, TFT_ORANGE);   // events waiting to upload

  // ===== BIG CARD: FINISHED (FG) =====
  uint16_t border = flashing ? flashColor : TFT_GREEN;
  spr.fillRoundRect(2, 33, SCR_W - 4, 46, 6, 0x0180);              // dark green card
  spr.drawRoundRect(2, 33, SCR_W - 4, 46, 6, border);
  spr.drawRoundRect(3, 34, SCR_W - 6, 44, 5, border);

  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(TFT_GREEN);
  spr.drawString("FINISHED (FG)", 8, 40, 1);

  spr.setTextDatum(MR_DATUM);                                      // style, top-right of the card
  spr.setTextColor(TFT_ORANGE);
  spr.drawString(hasJob ? styleNo : String("-"), SCR_W - 8, 40, 1);

  snprintf(buf, sizeof(buf), "%ld", finishedFG);
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(TFT_WHITE);
  spr.setFreeFont(&FreeSansBold24pt7b);
  if (spr.textWidth(buf) > SCR_W - 16) spr.setFreeFont(&FreeSansBold18pt7b);
  spr.drawString(buf, SCR_W / 2, 72);
  spr.setTextFont(1);

  // ===== STATUS STRIP =====
  int sy = 81, sh = 13;
  spr.setTextDatum(MC_DATUM);
  if (flashing) {
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, flashColor);
    spr.setTextColor(TFT_BLACK);
    spr.drawString(flashText, SCR_W / 2, sy + sh / 2 + 1, 1);
  } else if (!hasJob) {
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, 0x18E3);
    spr.setTextColor(TFT_SILVER);
    spr.drawString("WAITING FOR JOB", SCR_W / 2, sy + sh / 2 + 1, 1);
  } else if (qtyRemaining <= 0 && pulseCount == 0) {
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, TFT_GREEN);
    spr.setTextColor(TFT_BLACK);
    spr.drawString("JOB DONE", SCR_W / 2, sy + sh / 2 + 1, 1);
  } else if (garmentPresent && pulseCount >= stitchN) {
    // reached MAX: tell operator to remove (FG counts on removal)
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, TFT_GREEN);
    spr.setTextColor(TFT_BLACK);
    snprintf(buf, sizeof(buf), "COMPLETE %d - REMOVE", pulseCount);
    spr.drawString(buf, SCR_W / 2, sy + sh / 2 + 1, 1);
  } else if (garmentPresent) {
    // progress bar: dark green below MIN, bright green once MIN reached
    bool okZone = (pulseCount >= stitchMin);
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, 0x18E3);
    int fillW = (SCR_W - 8) * min(pulseCount, stitchN) / max(stitchN, 1);
    if (fillW > 0) spr.fillRoundRect(4, sy + 2, fillW, sh - 4, 2, okZone ? 0x07E0 : 0x03A0);
    int minX = 4 + (SCR_W - 8) * stitchMin / max(stitchN, 1);       // MIN marker
    spr.drawFastVLine(minX, sy + 1, sh - 2, TFT_YELLOW);
    spr.setTextColor(okZone ? TFT_BLACK : TFT_WHITE);
    if (okZone) snprintf(buf, sizeof(buf), "STITCH %d/%d  OK", pulseCount, stitchN);
    else        snprintf(buf, sizeof(buf), "STITCH %d/%d MIN %d", pulseCount, stitchN, stitchMin);
    spr.drawString(buf, SCR_W / 2, sy + sh / 2 + 1, 1);
  } else {
    spr.fillRoundRect(2, sy, SCR_W - 4, sh, 4, 0x18E3);
    spr.setTextColor(TFT_YELLOW);
    spr.drawString("PLACE GARMENT", SCR_W / 2, sy + sh / 2 + 1, 1);
  }

  // ===== COUNT BOXES: QTY / DISC / N =====
  int by = 95, bh = SCR_H - by, gap = 2;
  int bw = (SCR_W - 2 * gap) / 3;
  drawBox(0,              by, bw, bh, "QTY",  hasJob ? qtyRemaining : 0, TFT_CYAN,
          flashing && flashColor == TFT_GREEN);
  drawBox(bw + gap,       by, bw, bh, "DISC", discardedCnt, TFT_RED,
          flashing && flashColor == TFT_RED);
  drawBox(2 * (bw + gap), by, bw, bh, "N",    stitchN,      TFT_YELLOW, false);

  spr.pushSprite(0, 0);
}

// =================================================
// SENSORS / COUNTING
// =================================================
// Decision is made ONLY here, when the garment leaves the machine
void onGarmentRemoved() {
  if (pulseCount >= stitchMin && qtyRemaining > 0) {
    // 40..50 (or more) stitches -> good piece
    finishedFG++;
    qtyRemaining--;
    queueEvent("OP_DONE", (uint8_t)min(pulseCount, 255));
    flash("FG +1   (" + String(pulseCount) + " ST)", TFT_GREEN);
    Serial.printf("FG COUNTED at %d st  Q=%ld FG=%ld\n", pulseCount, qtyRemaining, finishedFG);
    beep(1);
  } else if (pulseCount > 0 && pulseCount < stitchMin) {
    // removed too early -> discard
    discardedCnt++;
    queueEvent("OP_DISCARD", (uint8_t)pulseCount);
    flash("DISCARDED " + String(pulseCount) + "/" + String(stitchMin), TFT_RED);
    Serial.printf("DISCARDED at %d (min %d)  DISC=%ld\n", pulseCount, stitchMin, discardedCnt);
    beep(2);
  }
  pulseCount = 0;
  render();
}

void readGarmentSensor() {
  bool raw = (digitalRead(irPin) == IR_ACTIVE_LEVEL);
  if (raw != irCandidate) {                 // changed: start timing
    irCandidate = raw;
    irCandidateSince = millis();
    return;
  }
  if (raw == garmentPresent) return;

  unsigned long needed = raw ? PRESENT_CONFIRM_MS : ABSENT_CONFIRM_MS;
  if (millis() - irCandidateSince >= needed) {
    garmentPresent = raw;
    if (!garmentPresent) onGarmentRemoved();
    else render();
  }
}

void processPulses() {
  noInterrupts();
  uint32_t n = isrPulses;
  isrPulses = 0;
  interrupts();
  if (n == 0) return;
  lastPulseSeenMs = millis();

  bool changed = false;
  while (n--) {
    if (garmentPresent && qtyRemaining > 0 && styleNo.length() > 0) {
      if (pulseCount < 255) pulseCount++;   // stitches beyond MAX still same garment
      changed = true;
      if (pulseCount == stitchN) {          // reached MAX: only a signal, no FG yet
        Serial.printf("COMPLETE %d/%d - waiting for removal\n", pulseCount, stitchN);
        beep(1);
      }
    }
    // no garment / no job: pulse ignored
  }
  if (changed) render();
}

// =================================================
// WIFI
// =================================================
void connectWiFi(unsigned long timeoutMs) {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long t = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t < timeoutMs) delay(200);
}

// Non-blocking: if Wi-Fi dropped, ask the radio to reconnect now and then
void keepWiFiAlive() {
  static unsigned long lastTry = 0;
  if (WiFi.status() == WL_CONNECTED) return;
  if (millis() - lastTry < WIFI_RETRY_MS) return;
  lastTry = millis();
  Serial.printf("WiFi not connected - retrying \"%s\"...\n", WIFI_SSID);
  WiFi.disconnect();
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}

