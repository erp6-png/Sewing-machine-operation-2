void drawOtaScreen(int pct, unsigned int done, unsigned int total,
                   const String &msg, uint16_t headCol, bool error) {
  spr.fillSprite(TFT_BLACK);
  spr.fillRect(0, 0, SCR_W, 18, headCol);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_WHITE);
  spr.drawString("FIRMWARE UPDATE", SCR_W / 2, 9, 2);
  spr.setTextColor(TFT_SILVER);
  spr.drawString(MACHINE_ID, SCR_W / 2, 26, 1);

  if (error) {
    spr.setTextColor(TFT_RED);
    spr.drawString("UPDATE FAILED", SCR_W / 2, 52, 2);
    spr.setTextColor(TFT_WHITE);
    spr.drawString(msg, SCR_W / 2, 74, 1);
    spr.setTextColor(TFT_SILVER);
    spr.drawString("OLD FIRMWARE KEPT", SCR_W / 2, 92, 1);
    spr.setTextColor(TFT_DARKGREY);
    spr.drawString("FW " FW_VERSION, SCR_W / 2, 122, 1);
    spr.pushSprite(0, 0);
    return;
  }

  char buf[8];
  snprintf(buf, sizeof(buf), "%d%%", pct);
  spr.setTextDatum(C_BASELINE);
  spr.setTextColor(pct >= 100 ? TFT_GREEN : TFT_WHITE);
  spr.setFreeFont(&FreeSansBold18pt7b);
  spr.drawString(buf, SCR_W / 2, 68);
  spr.setTextFont(1);

  int bx = 8, by = 76, bw = SCR_W - 16, bh = 12;
  uint16_t barCol = (pct >= 100) ? TFT_GREEN : TFT_CYAN;
  spr.drawRoundRect(bx, by, bw, bh, 3, barCol);
  int fill = (bw - 4) * pct / 100;
  if (fill > 0) spr.fillRoundRect(bx + 2, by + 2, fill, bh - 4, 2, barCol);

  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_SILVER);
  if (total > 0)
    spr.drawString(String(done / 1024) + " / " + String(total / 1024) + " KB", SCR_W / 2, 98, 1);

  spr.setTextColor(pct >= 100 ? TFT_GREEN : TFT_ORANGE);
  spr.drawString(msg, SCR_W / 2, 111, 1);
  spr.setTextColor(TFT_DARKGREY);
  spr.drawString("FW " FW_VERSION, SCR_W / 2, 122, 1);
  spr.pushSprite(0, 0);
}

String otaErrorText(ota_error_t e) {
  if (e == OTA_AUTH_ERROR)    return "WRONG OTA PASSWORD";
  if (e == OTA_BEGIN_ERROR)   return "NO SPACE / PARTITION";
  if (e == OTA_CONNECT_ERROR) return "PC CONNECT FAILED";
  if (e == OTA_RECEIVE_ERROR) return "DATA LOST - RETRY";
  if (e == OTA_END_ERROR)     return "VERIFY FAILED";
  return "ERROR " + String((int)e);
}

void startOTA() {
  ArduinoOTA.setHostname(MACHINE_ID);
  ArduinoOTA.setPassword(OTA_PASSWORD);

  ArduinoOTA.onStart([]() {
    otaInProgress = true;
    otaLastPct = -1;
    digitalWrite(buzzerPin, LOW);
    drawOtaScreen(0, 0, 0, "DO NOT POWER OFF", TFT_NAVY, false);
  });
  ArduinoOTA.onProgress([](unsigned int done, unsigned int total) {
    int pct = total ? (int)((uint64_t)done * 100 / total) : 0;
    if (pct != otaLastPct) {
      otaLastPct = pct;
      drawOtaScreen(pct, done, total, "DO NOT POWER OFF", TFT_NAVY, false);
    }
  });
  ArduinoOTA.onEnd([]() {
    drawOtaScreen(100, 0, 0, "DONE - RESTARTING...", TFT_DARKGREEN, false);
    delay(1500);
  });
  ArduinoOTA.onError([](ota_error_t e) {
    drawOtaScreen(0, 0, 0, otaErrorText(e), TFT_RED, true);
    delay(3000);
    otaInProgress = false;                   // back to the counter screen
    render();
  });

  ArduinoOTA.begin();
  otaStarted = true;
  flash("OTA READY " + WiFi.localIP().toString(), TFT_CYAN);
  Serial.printf("OTA READY: name %s  IP %s\n", MACHINE_ID, WiFi.localIP().toString().c_str());
}

// Start OTA as soon as Wi-Fi is up (boot or later reconnect)
void manageOTA() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!otaStarted) startOTA();
    ArduinoOTA.handle();
  } else if (otaStarted) {
    ArduinoOTA.end();                        // link lost: restart OTA after reconnect
    otaStarted = false;
  }
}

