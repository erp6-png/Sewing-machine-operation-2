// ================= PULSE INTERRUPT =================
volatile uint32_t isrPulses = 0;
volatile uint32_t lastPulseUs = 0;

void IRAM_ATTR onPulse() {
  uint32_t now = micros();
  if (now - lastPulseUs > PULSE_DEBOUNCE_US) {
    isrPulses++;
    lastPulseUs = now;
  }
}

// ================= EVENT QUEUE (only used with a server) =================
struct Event {
  const char*   type;      // "OP_DONE" or "OP_DISCARD"
  uint8_t       pulses;
  uint32_t      seq;
  unsigned long ms;        // millis() when it happened
  char          style[16];
};
const int QUEUE_SIZE = 40;
Event queueBuf[QUEUE_SIZE];
int qHead = 0, qCount = 0;
uint32_t eventSeq = 0;
uint32_t bootId = 0;

void queueEvent(const char* type, uint8_t pulses) {
#if USE_SERVER
  if (qCount >= QUEUE_SIZE) return;
  Event &e = queueBuf[(qHead + qCount) % QUEUE_SIZE];
  e.type = type;
  e.pulses = pulses;
  e.seq = ++eventSeq;
  e.ms = millis();
  strncpy(e.style, styleNo.c_str(), sizeof(e.style));
  e.style[sizeof(e.style) - 1] = 0;
  qCount++;
#else
  (void)type; (void)pulses;       // standalone: nothing to send
#endif
}

